
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Exibição de Tarefa</title>

    <!-- ícone da aba -->
    <link rel="icon" type="image/png" href="/imagens/logo.png">

    <!-- css específico dessa tela -->
    <link rel="stylesheet" href="/css/exibicao_tarefa.css" />
</head>
<body>

<!-- ==========================================================
     CABEÇALHO
     ========================================================== -->

<header class="cabecalho-tarefa">

    <!-- logo que volta pra home -->
    <a href="/" class="logo-tarefa">

        <img src="/imagens/logo.png"
             alt="Logo">

    </a>


    <!-- informações do cliente logado -->
    <div class="informacoes-funcionario">

        <span>
            Nome do Cliente
        </span>


        <!-- link pro perfil do cliente -->
        <a href="/Perfil/ClientePerfil"
           class="link-perfil">

            <img src="/imagens/Entrar.png"
                 alt="Perfil do cliente">

        </a>

    </div>

</header>


<!-- ==========================================================
     CONTEÚDO PRINCIPAL
     ========================================================== -->

<main class="conteudo-exibicao-tarefa">


    <!-- ======================================================
         FORMULÁRIO DA TAREFA
         ====================================================== -->

    <form>

        <!-- guarda o nome da tarefa que veio do controller -->
        <!-- o js usa isso depois pra saber qual tarefa tá aberta -->
        <input type="hidden"
               id="nomeTarefa"
               name="Tarefa"
               value="@ViewBag.Tarefa">


        <!-- ==================================================
             LINHA SUPERIOR
             ================================================== -->

        <div class="linha-superior-tarefa">


            <!-- título e botão voltar -->
            <div class="titulo-exibicao-tarefa">

                <!-- volta pra tela de tarefas do cliente -->
                <a href="/Tarefa/ClienteTarefa"
                   class="voltar-tarefa">

                    <img src="/imagens/voltar.png"
                         alt="Voltar">

                </a>


                <h1>
                    Exibição de Tarefa
                </h1>

            </div>


            <!-- ==================================================
                 SITUAÇÃO / STATUS
                 ================================================== -->

            <div class="situacao-tarefa"
                 id="containerSituacao">

                <span>
                    Status:
                </span>


                <!-- o cliente só vê o status, não pode mexer -->
                <select id="situacaoTarefa"
                        name="Status"
                        class="status-cliente"
                        disabled>

                    <option value="a_fazer">
                        A Fazer
                    </option>

                    <option value="andamento">
                        Em Andamento
                    </option>

                    <option value="finalizada">
                        Finalizada
                    </option>

                </select>

            </div>

        </div>


        <!-- ==================================================
             COLUNAS
             ================================================== -->

        <div class="colunas-tarefa">


            <!-- ==================================================
                 COLUNA ESQUERDA
                 ================================================== -->

            <section class="coluna-info-tarefa">


                <!-- TÍTULO DA TAREFA -->

                <div class="campo-tarefa">

                    <label for="tituloTarefa">
                        Título da Tarefa
                    </label>


                    <div class="campo-com-icone-tarefa">

                        <!-- readonly porque o cliente só visualiza -->
                        <input type="text"
                               id="tituloTarefa"
                               name="Titulo"
                               placeholder="Título da Tarefa"
                               readonly>

                    </div>

                </div>


                <!-- CATEGORIA -->

                <div class="campo-tarefa">

                    <label for="categoriaTarefa">
                        Categoria
                    </label>


                    <div class="campo-com-icone-tarefa">

                        <!-- disabled também, só visualização -->
                        <select id="categoriaTarefa"
                                name="Categoria"
                                disabled>

                            <option value=""
                                    selected
                                    disabled>

                                Selecione uma categoria

                            </option>

                            <option value="planejamento">
                                Planejamento
                            </option>

                            <option value="reuniao">
                                Reunião
                            </option>

                            <option value="criacao_conteudo">
                                Criação de Conteúdo
                            </option>

                            <option value="design">
                                Design
                            </option>

                            <option value="redacao">
                                Redação / Copywriting
                            </option>

                            <option value="social_media">
                                Social Media
                            </option>

                            <option value="gravacao">
                                Gravação
                            </option>

                            <option value="edicao_video">
                                Edição de Vídeo
                            </option>

                            <option value="fotografia">
                                Fotografia
                            </option>

                            <option value="campanha">
                                Publicidade / Campanha
                            </option>

                            <option value="desenvolvimento_projeto">
                                Desenvolvimento de Projeto
                            </option>

                            <option value="revisao">
                                Revisão
                            </option>

                            <option value="aprovacao">
                                Aprovação
                            </option>

                            <option value="entrega">
                                Entrega
                            </option>

                        </select>

                    </div>

                </div>


                <!-- DESCRIÇÃO -->

                <div class="campo-tarefa">

                    <label for="descricaoTarefa">
                        Descrição
                    </label>


                    <div class="campo-texto-tarefa">

                        <!-- readonly, o cliente não edita a descrição -->
                        <textarea id="descricaoTarefa"
                                  name="Descricao"
                                  placeholder="Texto.."
                                  readonly></textarea>

                    </div>

                </div>


                <!-- COMENTÁRIOS -->

                <div class="campo-tarefa">

                    <label for="comentariosTarefa">
                        Comentários
                    </label>


                    <div class="campo-com-icone-tarefa">

                        <!-- cliente só lê os comentários, não escreve -->
                        <input type="text"
                               id="comentariosTarefa"
                               name="Comentarios"
                               placeholder="Comentários"
                               readonly>

                    </div>

                </div>

            </section>


            <!-- ==================================================
                 COLUNA CENTRAL
                 ================================================== -->

            <section class="coluna-prazos-tarefa">


                <!-- DATA DE INÍCIO -->

                <div class="campo-tarefa">

                    <label for="dataInicio">
                        Data de Início
                    </label>


                    <div class="campo-com-icone-tarefa">

                        <!-- disabled, só pra visualizar -->
                        <input type="date"
                               id="dataInicio"
                               name="DataInicio"
                               disabled>

                    </div>

                </div>


                <!-- PREVISÃO DE TÉRMINO -->

                <div class="campo-tarefa">

                    <label for="previsaoTermino">
                        Previsão de Término
                    </label>


                    <div class="campo-com-icone-tarefa">

                        <input type="date"
                               id="previsaoTermino"
                               name="PrevisaoTermino"
                               disabled>

                    </div>

                </div>


                <!-- DATA DE ENTREGA -->

                <div class="campo-tarefa">

                    <label for="dataEntrega">
                        Data de Entrega
                    </label>


                    <div class="campo-com-icone-tarefa">

                        <input type="date"
                               id="dataEntrega"
                               name="DataEntrega"
                               disabled>

                    </div>

                </div>


                <!-- ==================================================
                     EQUIPE
                     ================================================== -->

                <h2 class="titulo-funcionarios">
                    Equipe:
                </h2>


                <div class="area-funcionarios">


                    <!-- funcionário 1 (exemplo fixo) -->

                    <div class="funcionario">

                        <img src="/imagens/Entrar.png"
                             alt="Funcionário"
                             class="icone-funcionario">

                        <span>
                            Nome - Função
                        </span>

                    </div>


                    <!-- funcionário 2 (exemplo fixo) -->

                    <div class="funcionario">

                        <img src="/imagens/Entrar.png"
                             alt="Funcionário"
                             class="icone-funcionario">

                        <span>
                            Nome - Função
                        </span>

                    </div>

                </div>


                <!-- o botão de baixar a equipe foi tirado -->
                <!-- cliente não tem ação administrativa nessa tela -->

            </section>


            <!-- ==================================================
                 COLUNA DIREITA
                 ================================================== -->

            <section class="coluna-arquivos-tarefa">

                <h2>
                    Arquivos:
                </h2>


                <div class="area-arquivos">


                    <!-- arquivo word -->

                    <div class="arquivo">

                        <img src="/imagens/documento.png"
                             alt="Docs"
                             class="icone-arquivo">


                        <span class="nome-arquivo">
                            doc_proj.docx
                        </span>


                        <!-- cliente só abre, não anexa nem troca -->
                        <a href="#"
                           class="botao-abrir-arquivo"
                           title="Abrir arquivo">

                            <img src="/imagens/abrir.png"
                                 alt="Abrir">

                        </a>

                    </div>


                    <!-- arquivo pdf -->

                    <div class="arquivo">

                        <img src="/imagens/documento.png"
                             alt="Docs"
                             class="icone-arquivo">


                        <span class="nome-arquivo">
                            pdf_proj.pdf
                        </span>


                        <a href="#"
                           class="botao-abrir-arquivo"
                           title="Abrir arquivo">

                            <img src="/imagens/abrir.png"
                                 alt="Abrir">

                        </a>

                    </div>


                    <!-- outro word -->

                    <div class="arquivo">

                        <img src="/imagens/documento.png"
                             alt="Docs"
                             class="icone-arquivo">


                        <span class="nome-arquivo">
                            doc(1)_proj.docx
                        </span>


                        <a href="#"
                           class="botao-abrir-arquivo"
                           title="Abrir arquivo">

                            <img src="/imagens/abrir.png"
                                 alt="Abrir">

                        </a>

                    </div>


                    <!-- outro pdf -->

                    <div class="arquivo">

                        <img src="/imagens/documento.png"
                             alt="Docs"
                             class="icone-arquivo">


                        <span class="nome-arquivo">
                            pdf(1)_proj.pdf
                        </span>


                        <a href="#"
                           class="botao-abrir-arquivo"
                           title="Abrir arquivo">

                            <img src="/imagens/abrir.png"
                                 alt="Abrir">

                        </a>

                    </div>

                </div>


                <!-- o botão de "+" pra adicionar arquivo foi removido -->
                <!-- cliente só visualiza, não envia arquivo -->

            </section>

        </div>

    </form>

</main>


<!-- js específico dessa tela -->
<script src="/js/exibicao_tarefa.js"></script>
</body>
</html>