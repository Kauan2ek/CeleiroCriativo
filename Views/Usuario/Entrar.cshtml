<!DOCTYPE html>
<html lang="pt-br">

<head>

    <!-- codificação de caracteres, pra acentos funcionarem -->
    <meta charset="UTF-8">

    <!-- garante que a página se adapte ao tamanho da tela -->
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <!-- título que aparece na aba do navegador -->
    <title>Entrar</title>

    <!-- ícone que aparece na aba -->
    <link rel="icon"
          type="image/png"
          href="/imagens/logo.png">

    <!-- css principal do site -->
    <link rel="stylesheet"
          href="/css/style.css">

</head>


<body>

    <!-- container principal da tela de login -->
    <main class="tela-entrar">

        <div class="caixa-login">


            <!-- botão de voltar pra home -->

            <div class="voltar-home">

                <a href="/Home/Index">

                    <img src="/imagens/voltar.png"
                         alt="Voltar para a página inicial">

                </a>

            </div>


            <h1>Entrar</h1>

            <!-- linha decorativa embaixo do título -->
            <div class="linha-titulo"></div>

            <!-- mensagem de sucesso do cadastro do cliente -->
            <!-- só aparece quando o ClienteController preenche o ViewBag.Sucesso -->
            @if (ViewBag.Sucesso != null)
            {
                <div class="mensagem-sucesso-login">
                    <span class="icone-sucesso">✓</span>
                    <span>@ViewBag.Sucesso</span>
                    <br>
                </div>
            }

            <!-- mensagem de erro do login (email ou senha incorreta) -->
            <!-- só aparece quando o UsuarioController preenche o ViewBag.Erro -->
            @if (ViewBag.Erro != null)
            {
                <div class="mensagem-erro-login">
                    <span class="icone-erro">!</span>
                    <span>@ViewBag.Erro</span>
                </div>
            }


            <!-- form de login -->
            <form action="/Usuario/Entrar" method="post">

                <label for="email">
                    E-mail
                </label>

                <input
                    type="email"
                    id="email"
                    name="Email"
                    placeholder="Digite seu e-mail"
                >


                <label for="senha">
                    Senha
                </label>

                <input
                    type="password"
                    id="senha"
                    name="Senha"
                    placeholder="Digite sua senha"
                >

                <!-- botão entrar, por enquanto só redireciona pro gestor -->
                <!-- ainda não tem validação de login de verdade -->
                <button type="submit">
                    Entrar
                </button>

            </form>

            <!-- link pra quem ainda não tem conta -->
            <div class="entrarcadastro">

                <p>
                    Ainda não tem cadastro?
                </p>

                <!-- manda pra seção de cadastro na home -->
                <a href="/Home/Index#cadastro">
                    Cadastre-se
                </a>

            </div>


        </div>

    </main>

</body>

</html>