@model List<Cliente>

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clientes</title>
    <link rel="stylesheet" href="/claude/style.css">
</head>
<body class="claude-list-page">
    <div class="claude-list-card">
        <div class="claude-toolbar">
            <h1>Clientes</h1>
            <a class="claude-btn-link" href="/Clientes/Create">+ Novo Cliente</a>
        </div>

        <table class="claude-table">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nome</th>
                    <th>Telefone</th>
                    <th>Documento</th>
                    <th>Email</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Cliente t in Model)
                {
                    <tr>
                        <td>@t.Codigo</td>
                        <td>@t.Nome</td>
                        <td>@t.Telefone</td>
                        <td>@t.TipoDocumento: @t.Documento</td>
                        <td>@t.Email</td>
                        <td>
                            <div class="claude-row-actions">
                                <a class="claude-link-btn" href="/Clientes/Update/@t.Codigo">Editar</a>
                                <form class="claude-inline-form" method="post" action="/Clientes/Delete/@t.Codigo">
                                    <button type="submit" class="claude-link-danger">Excluir</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
