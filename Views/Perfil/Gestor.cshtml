<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Perfil - Gestor</title>

    <!-- ícone da aba -->
    <link rel="icon" type="image/png" href="/imagens/logo.png">

    <!-- css específico dessa tela -->
    <link rel="stylesheet" href="~/css/perfil.css" />
</head>

<body>
    <!-- css específico dessa tela -->

    <div class="pagina-perfil">

        <!-- link que volta pra tela de projetos do gestor -->
        <a href="/Projeto/GestorProjeto" class="voltar-projetos">
            <img src="/imagens/voltar.png" alt="Voltar">
            Voltar para projetos
        </a>

        <!-- ==================== CABEÇALHO VERDE ==================== -->

        <!-- faixa com o título e a foto de perfil -->
        <div class="cabecalho-perfil">

            <h1>Perfil - Gestor</h1>

            <img src="/imagens/Entrar.png" alt="Perfil do gestor">

        </div>


        <!-- ==================== CAMPOS ==================== -->

        <!-- dados do perfil divididos em duas colunas -->
        <div class="dados-perfil">

            <!-- coluna esquerda -->

            <div class="coluna-perfil">

                <div class="campo-perfil">

                    <label for="nome">
                        Nome
                    </label>

                    <input type="text" id="nome" name="nome" placeholder="Digite seu nome">

                </div>


                <div class="campo-perfil">

                    <label for="email">
                        Email
                    </label>

                    <input type="email" id="email" name="email" placeholder="Digite seu email">

                </div>


                <div class="campo-perfil">

                    <label for="cpf">
                        CPF
                    </label>

                    <input type="text" id="cpf" name="cpf" placeholder="Digite seu CPF">

                </div>

            </div>


            <!-- coluna direita -->

            <div class="coluna-perfil">

                <div class="campo-perfil">

                    <label for="telefone">
                        Telefone
                    </label>

                    <input type="text" id="telefone" name="telefone" placeholder="Digite seu telefone">

                </div>


                <div class="campo-perfil">

                    <label for="senha">
                        Senha
                    </label>

                    <input type="password" id="senha" name="senha" placeholder="Digite sua senha">

                </div>


                <div class="campo-perfil">

                    <label for="cnpj">
                        CNPJ
                    </label>

                    <input type="text" id="cnpj" name="cnpj" placeholder="Digite seu CNPJ">

                </div>

            </div>

        </div>


        <!-- ==================== BOTÕES ==================== -->

        <div class="botoes-perfil">

            <!-- botão de editar (ainda sem função) -->
            <button type="button" class="botao-perfil">

                Editar perfil

            </button>


            <!-- botão salvar, chama a função js que redireciona -->
            <button type="button" class="botao-perfil" onclick="salvarPerfil()">

                Salvar

            </button>

        </div>

    </div>


    <script>

            // função chamada quando clica em salvar
            // pega a url da tela anterior e volta pra ela
            // se não tiver tela anterior, manda pro gestor de projeto
            function salvarPerfil() {

                const telaAnterior = document.referrer;

                if (telaAnterior) {

                    window.location.href = telaAnterior;

                } else {

                    window.location.href = "/Projeto/GestorProjeto";

                }

            }

    </script>
</body>