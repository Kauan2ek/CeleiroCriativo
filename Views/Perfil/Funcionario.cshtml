@model Funcionario
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Perfil - Funcionário</title>

    <!-- ícone da aba -->
    <link rel="icon" type="image/png" href="/imagens/logo.png">

    <!-- css específico dessa tela -->
    <link rel="stylesheet" href="~/css/perfil.css" />
</head>

<body>

    <div class="pagina-perfil">

        <!-- link que volta pra tela de projetos do funcionário -->
        <a href="/Projeto/FuncionarioProjeto" class="voltar-projetos">
            <img src="/imagens/voltar.png" alt="Voltar">
            Voltar para projetos
        </a>

        <!-- ==================== CABEÇALHO VERDE ==================== -->

        <!-- faixa com o título e a foto de perfil -->
        <div class="cabecalho-perfil">

            <h1>Perfil - Funcionário</h1>

            <img src="/imagens/Entrar.png" alt="Perfil do funcionario">

        </div>


        <!-- ==================== MENSAGENS ==================== -->

        <!-- mensagem de sucesso do SalvarFuncionario -->
        @if (ViewBag.Sucesso != null)
        {
            <div class="mensagem-crud sucesso">@ViewBag.Sucesso</div>
        }

        <!-- mensagem de erro do SalvarFuncionario ou do Desativar -->
        @if (ViewBag.Erro != null)
        {
            <div class="mensagem-crud erro">@ViewBag.Erro</div>
        }


        <!-- ==================== CAMPOS ==================== -->

        <!-- os nomes dos campos são os nomes das propriedades da model Funcionario (model binding) -->
        <!-- os campos começam travados (readonly) e o botão "Editar perfil" libera -->
        <form id="formPerfil" action="/Perfil/SalvarFuncionario" method="post">

            <!-- dados do perfil divididos em duas colunas -->
            <div class="dados-perfil">

                <!-- coluna esquerda -->

                <div class="coluna-perfil">

                    <div class="campo-perfil">
                        <label for="nome">Nome</label>
                        <input type="text" id="nome" name="Nome" value="@Model.Nome" placeholder="Digite seu nome" readonly>
                    </div>

                    <div class="campo-perfil">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="Email" value="@Model.Email" placeholder="Digite seu email" readonly>
                    </div>

                    <!-- o documento não pode ser alterado pelo perfil: fica sempre bloqueado (disabled nem é enviado no formulário) -->
                    <div class="campo-perfil">
                        <label for="documento">@Model.TipoDocumento.ToUpper()</label>
                        <!-- data-mascara: o mascara.js mostra o documento formatado (o banco guarda só os números) -->
                        <input type="text" id="documento" value="@Model.Documento" data-mascara="cpf-cnpj" disabled>
                    </div>

                    <!-- esse campo a mais é o cargo, só tem no perfil do funcionário -->
                    <!-- quem muda o cargo é o gestor, no cadastro de funcionários, então aqui também fica bloqueado -->
                    <div class="campo-perfil">
                        <label for="cargo">Cargo</label>
                        <input type="text" id="cargo" value="@Model.Cargo.Descricao" disabled>
                    </div>

                </div>


                <!-- coluna direita -->

                <div class="coluna-perfil">

                    <div class="campo-perfil">
                        <label for="telefone">Telefone</label>
                        <input type="text" id="telefone" name="Telefone" value="@Model.Telefone" placeholder="(99) 99999-9999" data-telefone readonly>
                    </div>

                    <!-- a senha nunca vem preenchida: em branco mantém a senha atual -->
                    <div class="campo-perfil">
                        <label for="senha">Nova senha</label>
                        <input type="password" id="senha" name="Senha" placeholder="Deixe em branco para manter a atual" readonly>
                    </div>

                    <div class="campo-perfil">
                        <label for="confirmarSenha">Confirmar nova senha</label>
                        <input type="password" id="confirmarSenha" name="ConfirmarSenha" placeholder="Repita a nova senha" readonly>
                    </div>

                </div>

            </div>

        </form>


        <!-- ==================== BOTÕES ==================== -->

        <div class="botoes-perfil">

            <!-- libera os campos travados pra edição -->
            <button type="button" class="botao-perfil" onclick="editarPerfil()">
                Editar perfil
            </button>

            <!-- form="formPerfil": envia o formulário dos campos lá de cima (um form não pode ficar dentro do outro) -->
            <button type="submit" class="botao-perfil" form="formPerfil">Salvar</button>

            <!-- desativa o próprio funcionário (exclusão lógica) e sai do sistema -->
            <form action="/Perfil/Desativar" method="post"
                  onsubmit="return confirm('Tem certeza que deseja desativar seu perfil? Você não conseguirá mais entrar no sistema.');">
                <button type="submit" class="botao-perfil">Desativar</button>
            </form>

            <form action="/Usuario/Sair" method="get">
                <button type="submit" class="botao-perfil">Sair</button>
            </form>

        </div>

    </div>


    <!-- máscara de CPF/CNPJ do campo de documento -->
    <script src="/js/mascara.js"></script>

    <script>

        // função chamada quando clica em "Editar perfil"
        // tira o readonly dos campos travados (documento e cargo são disabled, então continuam bloqueados)
        function editarPerfil() {

            const campos = document.querySelectorAll(".campo-perfil input[readonly]");

            campos.forEach(function (campo) {
                campo.removeAttribute("readonly");
            });

            document.getElementById("nome").focus();

        }

    </script>
</body>
