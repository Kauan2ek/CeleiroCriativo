@{
    // define o título da página que aparece na aba do navegador
    // o ViewData é um dicionário que passa dados do controller pra view
    ViewData["Title"] = "Exibição de Projeto";
}

<!-- css específico dessa tela de exibição -->
<link rel="stylesheet" href="/css/exibicao_projeto.css" />

<!-- js que cuida dos comportamentos dessa tela -->
<script src="/js/projeto.js"></script>

<!-- ==================== CABEÇALHO ==================== -->

<header class="cabecalho-projeto">

    <!-- Logo - volta para a tela de home -->
    <a href="/" class="logo-projeto">
        <img src="/imagens/logo.png"
            alt="Logo">
    </a>

    <!-- Informações do gestor -->
    <div class="informacoes-funcionario">

        <!-- nome do funcionário logado (fixo por enquanto) -->
        <span>Nome do Funcionário</span>

        <!-- link que leva pro perfil do funcionário -->
        <a href="/Perfil/FuncionarioPerfil"
           class="link-perfil">

            <img src="/imagens/Entrar.png"
                 alt="Perfil do funcionario">

        </a>

    </div>

</header>

<!-- ==================== CONTEÚDO ==================== -->

<main class="conteudo-exibicao">

    <!-- ==================== FORMULÁRIO ==================== -->

    <!-- form que envia os dados do projeto pro controller -->
    <form method="post"
          action="/Projeto/Salvar">

        <!-- ==================== LINHA SUPERIOR ==================== -->

        <div class="linha-superior">

            <div class="titulo-exibicao">

                <!-- botão de voltar pra tela de projetos do gestor -->
                <a href="/Projeto/GestorProjeto"
                   class="voltar-projetos">

                    <img src="/imagens/voltar.png"
                         alt="Voltar">

                </a>

                <h1>Exibição de Projeto</h1>

            </div>

            <!-- Situação -->
            <div class="situacao analise">

                <span>Situação:</span>

                <!-- select com os status possíveis do projeto -->
                <select id="situacaoProjeto"
                        name="Situacao"
                        class="status-cliente-funcionario">

                    <option value="analise" selected>
                        Em análise
                    </option>

                    <option value="andamento">
                        Em andamento
                    </option>

                    <option value="finalizado">
                        Finalizado
                    </option>

                </select>

            </div>

        </div>

        <!-- ==================== COLUNAS ==================== -->

        <!-- divide a tela em três colunas: esquerda, meio e direita -->
        <div class="colunas-projeto">

            <!-- ==================== COLUNA ESQUERDA ==================== -->

            <section class="coluna-esquerda">

                <!-- Título -->
                <div class="campo-projeto">

                    <label for="tituloProjeto">
                        Título do Projeto
                    </label>

                    <div class="campo-com-icone">

                        <input type="text"
                               id="tituloProjeto"
                               name="Titulo"
                               placeholder="Título do Projeto">

                    </div>

                </div>

                <!-- Descrição -->
                <div class="campo-projeto">

                    <label for="descricaoProjeto">
                        Descrição de Ideia:
                    </label>

                    <div class="campo-texto">

                        <!-- textarea pra descrição, que costuma ser um texto maior -->
                        <textarea id="descricaoProjeto"
                                  name="Descricao"
                                  placeholder="Texto.."></textarea>

                    </div>

                </div>

                <!-- Comentários -->
                <div class="campo-projeto">

                    <label for="comentariosProjeto">
                        Comentários
                    </label>

                    <div class="campo-com-icone">

                        <input type="text"
                               id="comentariosProjeto"
                               name="Comentarios"
                               placeholder="Digite um comentário">

                    </div>

                </div>

            </section>

            <!-- ==================== COLUNA DO MEIO ==================== -->

            <section class="coluna-meio">

                <!-- Data de início -->
                <div class="campo-projeto">

                    <label for="dataInicio">
                        Data de Início
                    </label>

                    <div class="campo-com-icone">

                        <input type="date"
                               id="dataInicio"
                               name="DataInicio">

                    </div>

                </div>

                <!-- Previsão de término -->
                <div class="campo-projeto">

                    <label for="previsaoTermino">
                        Previsão de Término
                    </label>

                    <div class="campo-com-icone">

                        <input type="date"
                               id="previsaoTermino"
                               name="PrevisaoTermino">

                    </div>

                </div>

                <!-- Data de entrega -->
                <div class="campo-projeto">

                    <label for="dataEntrega">
                        Data de Entrega
                    </label>

                    <div class="campo-com-icone">

                        <input type="date"
                               id="dataEntrega"
                               name="DataEntrega">

                    </div>

                </div>

            </section>

            <!-- ==================== COLUNA DIREITA ==================== -->

            <section class="coluna-tarefas">

                <h2>Tarefas:</h2>

                <div class="area-tarefas">

                    <!-- Tarefa -->
                    <div class="tarefa">

                        <!-- ícone do responsável pela tarefa -->
                        <img src="/imagens/Entrar.png"
                             alt="Responsável"
                             class="icone-responsavel">

                        <input type="text"
                               id="tituloTarefa"
                               name="Tarefa"
                               placeholder="Título Tarefa">

                        <!-- link que abre a tarefa na visão do funcionário -->
                        <a href="/Tarefa/FuncionarioTarefa" class="botao-expandir">
                            <img src="~/imagens/abrir.png" alt="Abrir">
                        </a>

                    </div>

                </div>

            </section>

        </div>

        <!-- ==================== AÇÕES DO PROJETO ==================== -->

        <div class="acoes-projeto">

            <!-- Botão Salvar -->
            <!-- por enquanto só volta pra tela anterior via history.back() -->
            <button type="button"
                    class="botao-salvar"
                    onclick="history.back()">
                Salvar
            </button>

            <!-- Botões Aprovar e Negar -->
            <div class="botoes-aprovacao"
                 id="botoesAprovacao">

                <button type="button"
                        class="botao-aprovar">

                    Aprovar

                </button>

                <button type="button"
                        class="botao-negar">

                    Negar

                </button>

            </div>

        </div>

    </form>

</main>