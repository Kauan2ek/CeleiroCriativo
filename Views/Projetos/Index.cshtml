@model List<Projeto>

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projetos</title>
    <link rel="stylesheet" href="/claude/style.css">
</head>
<body class="claude-list-page">
    <div class="claude-list-card">
        <div class="claude-toolbar">
            <h1>Projetos</h1>
            <a class="claude-btn-link" href="/Projetos/Create">+ Novo Projeto</a>
        </div>

        <table class="claude-table">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Título</th>
                    <th>Descrição</th>
                    <th>Início</th>
                    <th>Fim</th>
                    <th>Prevista</th>
                    <th>Tarefas</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Projeto t in Model)
                {
                    <tr>
                        <td>@t.Codigo</td>
                        <td>@t.Titulo</td>
                        <td>@t.Descricao</td>
                        <td>@t.DataInicio.ToShortDateString()</td>
                        <td>@t.DataFim.ToShortDateString()</td>
                        <td>@t.DataPrevista.ToShortDateString()</td>
                        <td>@(t.tarefas?.Count ?? 0)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
