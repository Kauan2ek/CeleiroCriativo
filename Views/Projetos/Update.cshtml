@model Projeto

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Projeto</title>
    <link rel="stylesheet" href="/claude/style.css">
</head>
<body class="claude-form-page">
    <div class="claude-card">
        <h1>Editar Projeto</h1>
        <p class="claude-subtitle">Atualize os dados do projeto</p>

        <form method="post" action="/Projetos/Update/@Model.Codigo">
            <div class="claude-field">
                <label for="titulo">Título</label>
                <input type="text" id="titulo" name="Titulo" value="@Model.Titulo">
            </div>

            <div class="claude-field">
                <label for="descricao">Descrição</label>
                <textarea id="descricao" name="Descricao">@Model.Descricao</textarea>
            </div>

            <div class="claude-field">
                <label for="dataInicio">Data de Início</label>
                <input type="date" id="dataInicio" name="DataInicio" value="@Model.DataInicio.ToString("yyyy-MM-dd")">
            </div>

            <div class="claude-field">
                <label for="dataFim">Data de Fim</label>
                <input type="date" id="dataFim" name="DataFim" value="@Model.DataFim.ToString("yyyy-MM-dd")">
            </div>

            <div class="claude-field">
                <label for="dataPrevista">Data Prevista</label>
                <input type="date" id="dataPrevista" name="DataPrevista" value="@Model.DataPrevista.ToString("yyyy-MM-dd")">
            </div>

            <div class="claude-field">
                <label for="status">Status</label>
                <select id="status" name="Status.Codigo">
                    @foreach (var status in StatusController.Lista)
                    {
                        <option value="@status.Codigo" selected="@(Model.Status != null && Model.Status.Codigo == status.Codigo)">@status.Descricao</option>
                    }
                </select>
            </div>

            <div class="claude-actions">
                <a class="claude-back-link" href="/Projetos/Index">&larr; Voltar</a>
                <button type="submit" class="claude-btn">Salvar</button>
            </div>
        </form>
    </div>
</body>
</html>
