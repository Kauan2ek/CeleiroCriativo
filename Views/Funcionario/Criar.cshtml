@model Funcionario

@{
    bool editando = Model.Codigo > 0;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(editando ? "Editar Funcionário" : "Cadastro Funcionário") - Celeiro Criativo</title>
    <link rel="icon" type="image/png" href="/imagens/logo.png">
    <link rel="stylesheet" href="/css/cadastro_funcionario.css" />
</head>
<body>
    <!-- ==================== CABEÇALHO ==================== -->
    <header class="cabecalho-cadastro">
        <a href="/" class="logo-cadastro">
            <img src="/imagens/logo.png" alt="Logo">
        </a>

        <div class="informacoes-gestor">
            <span>Nome do Gestor</span>
            <a href="/Perfil/GestorPerfil" class="link-perfil">
                <img src="/imagens/Entrar.png" alt="Perfil do gestor">
            </a>
        </div>
    </header>

    <main class="conteudo-cadastro">
        <div class="titulo-cadastro">
            <a href="/Funcionario/IndexGestor" class="voltar-cadastro">
                <img src="/imagens/voltar.png" alt="Voltar">
            </a>

            <h1>@(editando ? "Editar Funcionário" : "Cadastrar Funcionário")</h1>

            <a href="/Funcionario/IndexGestor" class="botao-ver-funcionarios">
                Ver Funcionários
            </a>
        </div>

        @if (TempData["Erro"] != null)
        {
            <div class="mensagem-crud erro">@TempData["Erro"]</div>
        }

        <div class="caixa-cadastro">
            <!-- O mesmo POST cria ou atualiza de acordo com o Codigo. -->
            <form method="post" action="/Funcionario/Salvar">
                <input type="hidden" name="Codigo" value="@Model.Codigo">
                <input type="hidden" name="TipoDocumento" value="cpf">

                <div class="campo campo-nome">
                    <label for="Nome">Nome completo</label>
                    <input type="text"
                           id="Nome"
                           name="Nome"
                           value="@Model.Nome"
                           maxlength="50"
                           required
                           placeholder="Digite o nome completo">
                </div>

                <div class="linha-campos">
                    <div class="campo">
                        <label for="Documento">CPF</label>
                        <input type="text"
                               id="Documento"
                               name="Documento"
                               value="@Model.Documento"
                               maxlength="20"
                               required
                               placeholder="Digite o CPF">
                    </div>

                    <div class="campo">
                        <label for="Telefone">Telefone</label>
                        <input type="text"
                               id="Telefone"
                               name="Telefone"
                               value="@Model.Telefone"
                               maxlength="20"
                               placeholder="Digite o telefone">
                    </div>
                </div>

                <div class="campo">
                    <label for="Email">E-mail</label>
                    <input type="email"
                           id="Email"
                           name="Email"
                           value="@Model.Email"
                           maxlength="100"
                           required
                           placeholder="Digite o e-mail">
                </div>

                <div class="campo">
                    <label for="CargoCodigo">Cargo</label>
                    <!-- Cargos vêm do banco; nesta etapa são cadastrados pelo script de INSERT. -->
                    <select id="CargoCodigo" name="CargoCodigo" required>
                        <option value="">Selecione o cargo</option>
                        @foreach (Cargo cargo in ViewBag.Cargos)
                        {
                            if (Model.Cargo.Codigo == cargo.Codigo)
                            {
                                <option value="@cargo.Codigo" selected>@cargo.Descricao</option>
                            }
                            else
                            {
                                <option value="@cargo.Codigo">@cargo.Descricao</option>
                            }
                        }
                    </select>
                </div>

                <div class="linha-campos">
                    <div class="campo">
                        <label for="Senha">
                            Senha @(editando ? "(deixe vazia para manter a atual)" : "")
                        </label>
                        <input type="password"
                               id="Senha"
                               name="Senha"
                               placeholder="@(editando ? "Nova senha, se desejar" : "Digite a senha")">
                    </div>

                    <div class="campo">
                        <label for="ConfirmarSenha">Confirmar senha</label>
                        <input type="password"
                               id="ConfirmarSenha"
                               name="ConfirmarSenha"
                               placeholder="Confirme a senha">
                    </div>
                </div>

                <div class="botoes-cadastro">
                    <a href="/Funcionario/IndexGestor" class="botao-cancelar">Cancelar</a>
                    <button type="submit" class="botao-cadastrar">
                        @(editando ? "Salvar Alterações" : "Cadastrar")
                    </button>
                </div>
            </form>
        </div>
    </main>
</body>
</html>
