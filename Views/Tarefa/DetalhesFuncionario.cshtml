@model Tarefa

@{
    // Código 0 significa que o formulário está criando uma nova Tarefa (igual ao novoProjeto da tela do projeto).
    // Tarefa nova ainda não existe no banco, então ainda não pode receber comentários.
    bool novaTarefa = Model.Codigo == 0;

    // o banco só aceita comentário de quem está na equipe da tarefa (FK_Comentarios_TarefaFuncionario)
    // então o chat confere se o funcionário logado está na equipe (o código dele vem da sessão)
    // usado só pra habilitar ou não o envio de comentário; o resto da tarefa ele edita de qualquer jeito
    int? codigoLogado = Context.Session.GetInt32("codigo");
    bool naEquipe = Model.Funcionarios != null && Model.Funcionarios.Any(f => f.Codigo == codigoLogado);

    // trava da regra de negócio: tarefa finalizada, ou de projeto finalizado, não pode ser alterada
    // o ViewBag.StatusProjeto vem da DetalhesFuncionario do TarefaController (descrição do status do projeto)
    // usado no disabled dos campos e pra esconder os botões que alteram a tarefa
    bool editavel = Model.Status != "Finalizado" && ViewBag.StatusProjeto != "Finalizado";

    // o status da tarefa finalizada ainda pode ser alterado (pra reabrir), igual ao projeto finalizado
    // só trava o status quando o PROJETO está finalizado: aí nada da tarefa pode mudar
    // usado no disabled do select de status e pra mostrar o botão "Salvar Status"
    bool statusEditavel = ViewBag.StatusProjeto != "Finalizado";

    // data e hora de agora, pra preencher a Data de Início da tarefa que ainda não tem (mesma ideia da tela do gestor)
    // Now (e não Today) porque as colunas da tarefa são datetime: a hora é gravada
    DateTime dataHoraAtual = DateTime.Now;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(novaTarefa ? "Nova Tarefa" : "Exibição de Tarefa")</title>

    <!-- ícone da aba -->
    <link rel="icon" type="image/png" href="/imagens/logo.png">

    <!-- css específico dessa tela (o mesmo da tela do gestor) -->
    <link rel="stylesheet" href="/css/exibicao_tarefa.css" />
</head>
<body>
<!-- ==========================================================
     CABEÇALHO
     ========================================================== -->

<header class="cabecalho-tarefa">

    <!-- logo que volta pra home -->
    <a href="/" class="logo-tarefa">
        <img src="/imagens/logo.png" alt="Logo">
    </a>


    <!-- informações do funcionário logado (o nome vem da sessão, gravada no login) -->
    <div class="informacoes-funcionario">

        <span>
            @Context.Session.GetString("nome")
        </span>

        <!-- link pro perfil do funcionário -->
        <a href="/Perfil/FuncionarioPerfil"
           class="link-perfil">

            <img src="/imagens/Entrar.png"
                 alt="Perfil do funcionário">

        </a>

    </div>

</header>


<!-- ==========================================================
     CONTEÚDO PRINCIPAL
     ========================================================== -->

<main class="conteudo-exibicao-tarefa">

    <!-- mensagem de erro do Create, Update ou Delete -->
    <!-- o ViewBag.Erro vem do catch das actions da tarefa, ou do ?erro= da url quando o comentário/arquivo falha -->
    @if (ViewBag.Erro != null)
    {
        <div class="mensagem-crud erro">@ViewBag.Erro</div>
    }

    <!-- aviso de tarefa travada (azul): o ViewBag.Aviso vem da DetalhesFuncionario do TarefaController -->
    @if (ViewBag.Aviso != null)
    {
        <div class="mensagem-crud aviso">@ViewBag.Aviso</div>
    }


    <!-- ======================================================
         FORMULÁRIO DA TAREFA
         ====================================================== -->

    <form method="post"
          id="formTarefa"
          action=@(novaTarefa ? "/tarefa/create" : "/tarefa/update")>

        <!-- código 0 = tarefa nova (o form vai pro Create); maior que 0 = tarefa existente (vai pro Update) -->
        <input type="hidden" id="codigoTarefa" name="Codigo" value="@Model.Codigo">

        <!-- tarefa nova: veio da url (?idProjeto=2); tarefa existente: veio do banco pelo Read -->
        <input type="hidden" name="IdProjeto" value="@(Model.IdProjeto)">

        <!-- ==================================================
             LINHA SUPERIOR
             ================================================== -->

        <div class="linha-superior-tarefa">


            <!-- título da página -->

            <div class="titulo-exibicao-tarefa">

                <!-- botão de voltar pro kanban do projeto dono da tarefa (/Tarefa/IndexFuncionario/2) -->
                <a href="/Tarefa/IndexFuncionario/@Model.IdProjeto"
                   class="voltar-tarefa">

                    <img src="/imagens/voltar.png"
                         alt="Voltar">

                </a>


                <h1>
                    Exibição de Tarefa
                </h1>

            </div>


            <!-- lado direito da linha: visibilidade + status, um do lado do outro -->
            <div class="acoes-superiores-tarefa">

                <!-- ==================================================
                     VISIBILIDADE PRO CLIENTE (slider)
                     ================================================== -->
                <!-- mesmo slider da tela do gestor: checkbox escondido + hidden "false" com o mesmo name -->
                <!-- marcado chega "true,false" e o model binding fica com o primeiro (true); desmarcado chega só o "false" -->
                <label class="visibilidade-tarefa"
                       title="Quando ligado, o cliente vê esta tarefa">
                    <span>Visível ao cliente</span>

                    <input type="checkbox"
                           name="Visibilidade"
                           value="true"
                           checked="@Model.Visibilidade"
                           disabled="@(!editavel)">

                    <span class="slider-visibilidade"></span>
                </label>
                <input type="hidden" name="Visibilidade" value="false">


                <!-- ==================================================
                     SITUAÇÃO / STATUS DA TAREFA
                     ================================================== -->
                <!-- em tarefa nova o exibicao_tarefa.js esconde esse bloco (a tarefa nasce "A fazer") -->
                <div class="situacao-tarefa"
                     id="containerSituacao">

                    <span>
                        Status:
                    </span>

                    <!-- statusEditavel (e não editavel): na tarefa finalizada o status continua liberado, pra dar pra reabrir -->
                    <select id="situacaoTarefa"
                            name="Status"
                            disabled="@(!statusEditavel)">
                        <option value="A fazer" selected="@(Model.Status == "A fazer" || Model.Status == "" || Model.Status == null)">
                            A Fazer
                        </option>
                        <option value="Em andamento" selected="@(Model.Status == "Em andamento")">
                            Em Andamento
                        </option>
                        <option value="Finalizado" selected="@(Model.Status == "Finalizado")">
                            Finalizada
                        </option>
                    </select>

                </div>

            </div>

        </div>


        <!-- ==================================================
             COLUNAS
             ================================================== -->

        <div class="colunas-tarefa">


            <!-- ==================================================
                 COLUNA ESQUERDA
                 informações da tarefa
                 ================================================== -->

            <section class="coluna-info-tarefa">


                <!-- TÍTULO DA TAREFA -->

                <div class="campo-tarefa">

                    <label for="tituloTarefa">
                        Título da Tarefa
                    </label>

                    <div class="campo-com-icone-tarefa">

                        <input type="text"
                               id="tituloTarefa"
                               name="Titulo"
                               placeholder="Título da Tarefa"
                               value="@Model.Titulo"
                               disabled="@(!editavel)">

                        <img src="/imagens/editar.png"
                             alt="Editar">

                    </div>

                </div>


                <!-- CATEGORIA -->

                <div class="campo-tarefa">

                    <label for="categoriaTarefa">
                        Categoria
                    </label>

                    <div class="campo-com-icone-tarefa">

                        <!-- as opções vêm da ViewBag.Categorias; na tarefa existente, a categoria dela já vem selecionada -->
                        <select id="categoriaTarefa"
                                name="Categoria.Codigo"
                                disabled="@(!editavel)">
                            <option value=""
                                    selected
                                    disabled>

                                Selecione uma categoria

                            </option>

                            @foreach (var categoria in ViewBag.Categorias)
                            {
                                @if (!novaTarefa && Model.Categoria.Codigo == categoria.Codigo){
                                    <option value="@categoria.Codigo" selected>@categoria.Descricao</option>
                                } else {
                                    <option value="@categoria.Codigo">@categoria.Descricao</option>
                                }
                            }

                        </select>

                    </div>

                </div>


                <!-- DESCRIÇÃO -->

                <div class="campo-tarefa">

                    <label for="descricaoTarefa">
                        Descrição
                    </label>

                    <div class="campo-texto-tarefa">

                        <textarea id="descricaoTarefa"
                                  name="Descricao"
                                  placeholder="Texto.."
                                  disabled="@(!editavel)"
                        >@Model.Descricao</textarea>

                        <img src="/imagens/editar.png"
                             alt="Editar">

                    </div>

                </div>


                <!-- CAMPO DE COMENTÁRIOS -->
                <!-- mostra o último comentário (o js copia da última mensagem do chat, que foi montado no C#) -->
                <div class="campo-tarefa">
                    <label for="comentariosTarefa">Comentários</label>

                    @if (novaTarefa)
                    {
                        <p class="aviso-comentarios-tarefa">Salve a tarefa antes de comentar.</p>
                    }
                    else
                    {
                        <div class="campo-com-icone-tarefa campo-comentarios-chat">
                            <input type="text"
                                id="comentariosTarefa"
                                placeholder="Nenhum comentário ainda"
                                readonly
                                title="Último comentário"
                                value="">

                            <!-- o lápis abre a conversa completa -->
                            <img src="/imagens/editar.png"
                                alt="Abrir comentários"
                                id="iconeComentarios"
                                title="Abrir conversa">
                        </div>
                    }
                </div>

            </section>


            <!-- ==================================================
                 COLUNA CENTRAL
                 prazos e funcionários
                 ================================================== -->

            <section class="coluna-prazos-tarefa">


                <!-- DATA DE INÍCIO -->

                <div class="campo-tarefa">

                    <label for="dataInicio">
                        Data de Início
                    </label>

                    <div class="campo-com-icone-tarefa">

                        <!-- preenchida automaticamente: a do banco, ou a de agora se a tarefa ainda não tem -->
                        <!-- readonly: não dá pra digitar. A hora de agora aqui é só uma prévia: quem grava a data de verdade -->
                        <!-- é o Create/Update do TarefaController, com a hora do clique em Salvar -->
                        <!-- o type="datetime-local" só aceita o formato yyyy-MM-ddTHH:mm (o 'T' entre aspas simples sai como letra T mesmo) -->
                        <input type="datetime-local"
                               id="dataInicio"
                               name="DataHoraInicio"
                               value="@(Model.DataHoraInicio.HasValue ? Model.DataHoraInicio.Value.ToString("yyyy-MM-dd'T'HH:mm") : dataHoraAtual.ToString("yyyy-MM-dd'T'HH:mm"))"
                               readonly>

                    </div>

                </div>


                <!-- PREVISÃO DE TÉRMINO -->

                <div class="campo-tarefa">

                    <label for="previsaoTermino">
                        Previsão de Término
                    </label>

                    <div class="campo-com-icone-tarefa">

                        <input type="datetime-local"
                               id="previsaoTermino"
                               name="DataHoraPrevista"
                               value="@Model.DataHoraPrevista?.ToString("yyyy-MM-dd'T'HH:mm")"
                               disabled="@(!editavel)">

                    </div>

                </div>


                <!-- DATA DE ENTREGA -->

                <div class="campo-tarefa">

                    <label for="dataEntrega">
                        Data de Entrega
                    </label>

                    <div class="campo-com-icone-tarefa">

                        <!-- ninguém digita a entrega: o Update do TarefaController preenche quando a tarefa passa pra "Finalizado" -->
                        <input type="datetime-local"
                               id="dataEntrega"
                               name="DataHoraFim"
                               value="@Model.DataHoraFim?.ToString("yyyy-MM-dd'T'HH:mm")"
                               readonly>

                    </div>

                </div>


                <!-- FUNCIONÁRIOS -->

                <h2 class="titulo-funcionarios">
                    Funcionário(s):
                </h2>

                <!-- só mostra a equipe: o funcionário não adiciona nem remove ninguém (isso é só do gestor) -->
                <!-- por isso aqui não tem o botão + nem o modal de funcionários da tela do gestor -->
                <div class="area-funcionarios">

                    @if (Model.Funcionarios != null && Model.Funcionarios.Count() > 0)
                    {
                        @foreach (var funcionario in Model.Funcionarios)
                        {
                            <div class="funcionario">
                                <img src="/imagens/Entrar.png"
                                     alt="Funcionário"
                                     class="icone-funcionario">

                                <span>
                                    @funcionario.Nome - @funcionario.Cargo.Descricao
                                </span>
                            </div>
                        }
                    }
                    else
                    {
                        <span>Ainda não há funcionários para essa tarefa...</span>
                    }

                </div>

            </section>


            <!-- ==================================================
                 COLUNA DIREITA
                 arquivos
                 ================================================== -->

            <section class="coluna-arquivos-tarefa">

                <h2>
                    Arquivos:
                </h2>

                <div class="area-arquivos">
                    @if (Model.Documentos != null && Model.Documentos.Count() > 0)
                    {
                        @foreach (var documento in Model.Documentos)
                        {
                            <div class="arquivo">

                                <img src="/imagens/documento.png"
                                     alt="@documento.Extensao"
                                     class="icone-arquivo">

                                <span class="nome-arquivo"
                                      title="@($"{documento.Descricao}.{documento.Extensao}")">
                                    @($"{documento.Descricao}.{documento.Extensao}")
                                </span>

                                <!-- botão que abre o arquivo -->
                                <a href="@documento.Diretorio"
                                   target="_blank"
                                   class="botao-abrir-arquivo"
                                   title="Abrir arquivo">
                                    <img src="/imagens/abrir.png" alt="Abrir">
                                </a>

                                <!-- botão que exclui o arquivo (envia o form de exclusão desse documento, lá embaixo) -->
                                <!-- tarefa travada: some a lixeira (o botão Abrir continua) -->
                                @if (editavel)
                                {
                                    <button type="submit"
                                            form="formExcluirDocumento-@documento.Codigo"
                                            class="botao-excluir-arquivo"
                                            title="Excluir arquivo"
                                            onclick="return confirm('Tem certeza que deseja excluir este arquivo?')">
                                        <img src="/imagens/excluir_arquivo.png" alt="Excluir">
                                    </button>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <span>Ainda não há arquivos para essa tarefa...</span>
                    }

                </div>


                <!-- botão de adicionar arquivo: só em tarefa já salva (precisa do código da tarefa) e que não esteja travada -->
                @if (!novaTarefa && editavel)
                {
                    <div class="acoes-arquivos">
                        <input type="file"
                               id="arquivoTarefa"
                               name="arquivo"
                               form="formUploadDocumento"
                               style="display: none"
                               onchange="this.form.submit()">

                        <button type="button"
                                class="botao-adicionar-arquivo"
                                title="Adicionar arquivo"
                                onclick="document.getElementById('arquivoTarefa').click()">
                            +
                        </button>
                    </div>
                }

            </section>

        </div>


        <!-- ==================================================
             BOTÕES
             ================================================== -->

        @if (novaTarefa && editavel) // Create
        {
            <div class="acoes-exibicao-tarefa">
                <button type="submit"
                        class="botao-salvar-tarefa">
                    Nova Tarefa
                </button>
            </div>
        }
        else if (editavel) // Update e Delete: tarefa travada não mostra Salvar nem Excluir
        {
            <div class="acoes-exibicao-tarefa">
                <button type="button"
                        class="botao-excluir-tarefa"
                        onclick="confirmarExclusaoTarefa()">
                    Excluir tarefa
                </button>

                <button type="submit"
                        class="botao-salvar-tarefa">
                    Salvar
                </button>
            </div>
        }
        else if (statusEditavel) // tarefa finalizada (projeto não): só o status pode mudar, então só o "Salvar Status" (sem Excluir)
        {
            <div class="acoes-exibicao-tarefa">
                <button type="submit"
                        class="botao-salvar-tarefa">
                    Salvar Status
                </button>
            </div>
        }

    </form>

</main>

<!-- form próprio do upload: fora do form da tarefa, porque form dentro de form não é permitido -->
@if (!novaTarefa)
{
    <form id="formUploadDocumento"
          method="post"
          action="/Documento/Create"
          enctype="multipart/form-data">
        <input type="hidden" name="idTarefa" value="@Model.Codigo">
    </form>
}

<!-- um form de exclusão pra cada documento, também fora do form da tarefa -->
@if (Model.Documentos != null)
{
    @foreach (var documento in Model.Documentos)
    {
        <form id="formExcluirDocumento-@documento.Codigo"
              method="post"
              action="/Documento/Delete">
            <input type="hidden" name="id" value="@documento.Codigo">
            <input type="hidden" name="idTarefa" value="@Model.Codigo">
        </form>
    }
}

<!-- modal de exclusão da tarefa -->
@if (!novaTarefa)
{
<div id="modalExclusaoTarefa" class="modal-exclusao">
    <div class="caixa-exclusao">
        <h2>Excluir tarefa?</h2>

        <p>Tem certeza que deseja excluir esta tarefa?</p>

        <div class="acoes-exclusao">
            <button type="button"
                    class="botao-voltar-tarefa"
                    onclick="fecharModalExclusao()">
                Voltar para tarefa
            </button>

            <form method="post" action="/Tarefa/Delete">
                <input type="hidden" name="id" value="@Model.Codigo">
                <input type="hidden" name="idProjeto" value="@Model.IdProjeto">

                <button type="submit"
                        class="botao-confirmar-exclusao">
                    Excluir tarefa
                </button>
            </form>
        </div>
    </div>
</div>
}

<!-- ==========================================================
     MODAL DE COMENTÁRIOS - CHAT
     só existe pra tarefa já salva
     ========================================================== -->
@if (!novaTarefa)
{
<div id="modalComentarios" class="modal-comentarios">
    <div class="caixa-chat">

        <div class="cabecalho-chat">
            <div>
                <h2>Comentários da tarefa</h2>
                <span>Conversa entre os participantes</span>
            </div>
            <button type="button" id="fecharChat" class="fechar-chat">×</button>
        </div>

        <!-- as mensagens vêm do banco (Model.Comentarios, do mais antigo pro mais novo), montadas pelo C# -->
        <div id="mensagensChat" class="mensagens-chat">
            @if (Model.Comentarios != null && Model.Comentarios.Count() > 0) {
                @foreach (var comentario in Model.Comentarios)
                {
                    <div class="mensagem mensagem-outra">
                        <span class="nome-mensagem">(@comentario.Funcionario.Nome)</span>
                        <p>@comentario.Descricao</p>
                        <span class="horario-mensagem">@comentario.DataHora.ToString("dd/MM HH:mm")</span>
                    </div>
                }
            }
        </div>

        <!-- envia o comentário pra action Create do ComentarioController -->
        <form id="formularioChat" class="formulario-chat"
              method="post" action="/Comentario/Create">

            <!-- tarefa dona do comentário -->
            <input type="hidden" name="IdTarefa" value="@Model.Codigo">

            <!-- autor: o funcionário logado (o ComentarioController também pega da sessão, pra ninguém trocar esse valor) -->
            <input type="hidden" name="Funcionario.Codigo" value="@codigoLogado">

            <!-- o banco só aceita comentário de quem está na equipe: fora dela, o campo e o botão ficam desabilitados -->
            <!-- o !editavel bloqueia também quando a tarefa está travada (tarefa ou projeto finalizado) -->
            <input type="text" id="novoComentario"
                   name="Descricao"
                   placeholder="@(naEquipe ? "Digite seu comentário..." : "Só quem está na equipe da tarefa pode comentar")"
                   autocomplete="off" maxlength="500" required
                   disabled="@(!naEquipe || !editavel)">
            <button type="submit" class="enviar-comentario" disabled="@(!naEquipe || !editavel)">Enviar</button>
        </form>

    </div>
</div>
}

<!-- js específico dessa tela (o mesmo da tela do gestor) -->
<script src="/js/exibicao_tarefa.js"></script>
</body>
