<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tarefa</title>

    <!-- css específico dessa tela -->
    <link rel="stylesheet" href="~/css/tarefa.css" />
</head>
<body>


<!-- ==================== CABEÇALHO ==================== -->

<header class="cabecalho-tarefas">

    <!-- logo que volta pra home -->
    <a href="/" class="logo-tarefas">
        <img src="/imagens/logo.png" alt="Logo">
    </a>

    <!-- informações do funcionário logado -->
    <div class="informacoes-funcionario">

        <span>Nome do Funcionário</span>

        <!-- link pro perfil do funcionário -->
        <a href="/Perfil/FuncionarioPerfil"
           class="link-perfil">

            <img src="/imagens/Entrar.png"
                 alt="Perfil do funcionário">

        </a>

    </div>

</header>


<!-- ==================== CONTEÚDO ==================== -->

<main class="conteudo-tarefas">

    <!-- título da página com botão de voltar -->
    <div class="titulo-tarefas">

        <!-- volta pra tela de projetos do funcionário -->
        <a href="/Projeto/FuncionarioProjeto"
           class="voltar-tarefas">

            <img src="/imagens/voltar.png"
                 alt="Voltar">

        </a>

        <h1>Tarefas do Projeto</h1>

    </div>


    <!-- ==================== KANBAN ==================== -->

    <!-- quadro kanban com três colunas de status -->
    <div class="kanban-board">


        <!-- ==================== A FAZER ==================== -->

        <section class="coluna-tarefas coluna-analise">

            <div class="cabecalho-coluna">
                <h2>Tarefas a Fazer</h2>
            </div>

            <!-- corpo da coluna, o data-status indica o status das tarefas -->
            <div class="corpo-coluna"
                 data-status="a_fazer">

                <!-- card de tarefa -->
                <!-- draggable=true aqui, o funcionário pode arrastar entre colunas -->
                <div class="card-tarefa"
                     draggable="true"
                     data-tarefa="Texto da empresa...">

                    <div class="conteudo-card">

                        <p>Texto da empresa...</p>

                        <!-- link que abre a tarefa na visão do funcionário -->
                        <!-- passa o status e o nome da tarefa pela url -->
                        <a href="@Url.Action("ExTarefaFuncionario", "Tarefa", new { status = "a_fazer", tarefa = "Texto da empresa..." })"
                           class="botao-expandir-tarefa">

                            <img src="/imagens/abrir.png"
                                 alt="Abrir tarefa">

                        </a>

                    </div>

                    <!-- ações do card -->
                    <div class="acoes-card">

                        <button type="button"
                                class="botao-compartilhar">
                            Compartilhar
                        </button>

                    </div>

                </div>

            </div>

        </section>


        <!-- ==================== EM ANDAMENTO ==================== -->

        <section class="coluna-tarefas coluna-andamento">

            <div class="cabecalho-coluna">
                <h2>Tarefas em Andamento</h2>
            </div>

            <div class="corpo-coluna"
                 data-status="andamento">

                <div class="card-tarefa"
                     draggable="true"
                     data-tarefa="Documentação da Equipe">

                    <div class="conteudo-card">

                        <p>Documentação da Equipe</p>

                        <!-- abre a tarefa na visão do funcionário -->
                        <a href="@Url.Action("ExTarefaFuncionario", "Tarefa", new { status = "andamento", tarefa = "Documentação da Equipe" })"
                           class="botao-expandir-tarefa">

                            <img src="/imagens/abrir.png"
                                 alt="Abrir tarefa">

                        </a>

                    </div>

                    <div class="acoes-card">

                        <button type="button"
                                class="botao-compartilhar">
                            Compartilhar
                        </button>

                    </div>

                </div>

            </div>

        </section>


        <!-- ==================== FINALIZADAS ==================== -->

        <section class="coluna-tarefas coluna-finalizadas">

            <div class="cabecalho-coluna">
                <h2>Tarefas Finalizadas</h2>
            </div>

            <div class="corpo-coluna"
                 data-status="finalizada">

                <div class="card-tarefa"
                     draggable="true"
                     data-tarefa="Tarefa da Equipe - Análise">

                    <div class="conteudo-card">

                        <p>Tarefa da Equipe - Análise</p>

                        <!-- abre a tarefa na visão do funcionário -->
                        <a href="@Url.Action("ExTarefaFuncionario", "Tarefa", new { status = "finalizada", tarefa = "Tarefa da Equipe - Análise" })"
                           class="botao-expandir-tarefa">

                            <img src="/imagens/abrir.png"
                                 alt="Abrir tarefa">

                        </a>

                    </div>

                    <div class="acoes-card">

                        <button type="button"
                                class="botao-compartilhar">
                            Compartilhar
                        </button>

                    </div>

                </div>

            </div>

        </section>

    </div>

</main>


<!-- js que cuida dos comportamentos dessa tela -->
<script src="/js/tarefa.js"></script>
</body>