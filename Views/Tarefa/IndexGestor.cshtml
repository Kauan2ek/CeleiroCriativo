@model List<Tarefa>

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tarefa</title>

    <!-- ícone da aba -->
    <link rel="icon" type="image/png" href="/imagens/logo.png">

    <!-- css específico dessa tela -->
    <link rel="stylesheet" href="~/css/tarefa.css" />
</head>
<body>


<!-- ==================== CABEÇALHO ==================== -->

<header class="cabecalho-tarefas">

    <!-- logo que volta pra home -->
   <a href="/" class="logo-tarefas">
    <img src="/imagens/logo.png" alt="Logo">
   </a>


    <!-- atalho pra cadastrar funcionário -->
    <a href="/Funcionario/Criar"
       class="cadastrar-funcionario">

        <img src="/imagens/criar_funcionario.png"
             alt="Cadastrar funcionário">

        <span>Cadastrar Funcionário</span>

    </a>


    <!-- informações do gestor logado -->
    <div class="informacoes-gestor">

        <span>@(Context.Session.GetString("nome"))</span>

        <!-- link pro perfil do gestor -->
        <a href="/Perfil/GestorPerfil"
           class="link-perfil">

            <img src="/imagens/Entrar.png"
                 alt="Perfil do gestor">

        </a>

    </div>

</header>


<!-- ==================== CONTEÚDO ==================== -->

<main class="conteudo-tarefas">


    <!-- título da página com botão de voltar -->

    <div class="titulo-tarefas">

        <!-- botão de voltar: volta pra tela do projeto dono dessas tarefas -->
        <a href="/Projeto/DetalhesGestor/@ViewBag.IdProjeto"
           class="voltar-tarefas">

            <img src="/imagens/voltar.png"
                 alt="Voltar">

        </a>

        <h1>Tarefas do Projeto</h1>

    </div>


    <!-- mensagem do Compartilhar (sucesso ou erro) -->
    @if (ViewBag.Sucesso != null)
    {
        <div class="mensagem-crud sucesso">@ViewBag.Sucesso</div>
    }
    @if (ViewBag.Erro != null)
    {
        <div class="mensagem-crud erro">@ViewBag.Erro</div>
    }



    <!-- ==================== KANBAN ==================== -->

    <!-- quadro kanban com três colunas de status -->
    <!-- data-banco avisa o tarefa.js que os cards vêm do banco, então ele não mexe nos links nem nas colunas deles -->
    <div class="kanban-board" data-banco="true">


        <!-- ==================== A FAZER ==================== -->

        <section class="coluna-tarefas coluna-analise">

            <!-- cabeçalho da coluna com título e botão de criar -->

            <div class="cabecalho-coluna">

                <h2>Tarefas a Fazer</h2>

                <!-- botão que leva pra tela de criação de tarefa, já ligada a esse projeto -->
                <!-- projeto finalizado: o botão nem aparece (o ViewBag.StatusProjeto vem da IndexGestor do TarefaController) -->
                @if (ViewBag.StatusProjeto != "Finalizado")
                {
                    <a href="/Tarefa/DetalhesGestor?idProjeto=@ViewBag.IdProjeto"
                       class="botao-criar-tarefa">

                        + Criar Tarefa

                    </a>
                }

            </div>


            <!-- corpo da coluna, o data-status indica o status das tarefas -->
            <div class="corpo-coluna"
                 data-status="a_fazer">

                <!-- um card pra cada tarefa que não está em andamento nem finalizada -->
                <!-- (inclui status fora do padrão, pra nenhuma tarefa sumir do quadro) -->
                @foreach (Tarefa tarefa in Model.Where(t => t.Status != "Em andamento" && t.Status != "Finalizado"))
                {
                    <form method="post" action="@($"/Tarefa/Compartilhar/{tarefa.Codigo}")">
                        <input type="hidden" name="idProjeto" value="@ViewBag.IdProjeto">
                        <!-- draggable=false: arrastar entre colunas está desativado, porque não salvava no banco -->
                        <!-- o status muda pela tela da tarefa (select + Salvar) -->
                        <div class="card-tarefa"
                            draggable="false"
                            data-codigo="@tarefa.Codigo"
                            data-tarefa="@tarefa.Titulo">

                            <!-- conteúdo do card -->

                            <div class="conteudo-card">

                                <p>
                                    @tarefa.Titulo
                                </p>


                                <!-- botão pra abrir a tarefa -->
                                <!-- tem um button envolvendo o link, meio redundante mas ok -->

                                <button type="button"
                                        class="botao-expandir-tarefa">

                                    <a href="/Tarefa/DetalhesGestor/@tarefa.Codigo"
                                    class="botao-expandir-tarefa">

                                        <img src="/imagens/abrir.png"
                                            alt="Abrir tarefa">

                                    </a>

                                </button>

                            </div>


                            <!-- ação de compartilhar -->
                            @if (!tarefa.Visibilidade) 
                            {
                                <div class="acoes-card">

                                    <button type="submit"
                                            class="botao-compartilhar">
                                        Compartilhar
                                    </button>

                                </div>
                            }

                        </div>
                    </form>
                }

            </div>

        </section>



        <!-- ==================== EM ANDAMENTO ==================== -->

        <section class="coluna-tarefas coluna-andamento">


            <!-- cabeçalho da coluna -->

            <div class="cabecalho-coluna">

                <h2>Tarefas em Andamento</h2>

            </div>


            <div class="corpo-coluna"
                 data-status="andamento">

                <!-- um card pra cada tarefa em andamento -->
                @foreach (Tarefa tarefa in Model.Where(t => t.Status == "Em andamento"))
                {
                    <form method="post" action="@($"/Tarefa/Compartilhar/{tarefa.Codigo}")">
                    <input type="hidden" name="idProjeto" value="@ViewBag.IdProjeto">
                    <div class="card-tarefa"
                         draggable="false"
                         data-codigo="@tarefa.Codigo"
                         data-tarefa="@tarefa.Titulo">

                        <!-- conteúdo do card -->

                        <div class="conteudo-card">

                            <p>
                                @tarefa.Titulo
                            </p>


                            <!-- botão pra abrir a tarefa -->

                            <button type="button"
                                    class="botao-expandir-tarefa">

                                <a href="/Tarefa/DetalhesGestor/@tarefa.Codigo"
                                   class="botao-expandir-tarefa">

                                    <img src="/imagens/abrir.png"
                                         alt="Abrir tarefa">

                                </a>

                            </button>

                        </div>


                        <!-- ação de compartilhar -->

                        @if (!tarefa.Visibilidade)
                        {
                            <div class="acoes-card">

                                <button type="submit"
                                        class="botao-compartilhar">

                                    Compartilhar

                                </button>

                            </div>
                        }

                    </div>
                    </form>
                }

            </div>

        </section>



        <!-- ==================== FINALIZADAS ==================== -->

        <section class="coluna-tarefas coluna-finalizadas">


            <!-- cabeçalho da coluna -->

            <div class="cabecalho-coluna">

                <h2>Tarefas Finalizadas</h2>

            </div>


            <div class="corpo-coluna"
                 data-status="finalizada">

                <!-- um card pra cada tarefa finalizada -->
                @foreach (Tarefa tarefa in Model.Where(t => t.Status == "Finalizado"))
                {
                    <div class="card-tarefa"
                         draggable="false"
                         data-codigo="@tarefa.Codigo"
                         data-tarefa="@tarefa.Titulo">

                        <!-- conteúdo do card -->

                        <div class="conteudo-card">

                            <p>
                                @tarefa.Titulo
                            </p>


                            <!-- botão pra abrir a tarefa -->

                            <button type="button"
                                    class="botao-expandir-tarefa">

                                <a href="/Tarefa/DetalhesGestor/@tarefa.Codigo"
                                   class="botao-expandir-tarefa">

                                    <img src="/imagens/abrir.png"
                                         alt="Abrir tarefa">

                                </a>

                            </button>

                        </div>

                    </div>
                }

            </div>

        </section>


    </div>

</main>


<!-- js que cuida dos comportamentos dessa tela -->

<script src="/js/tarefa.js"></script>
</body>
