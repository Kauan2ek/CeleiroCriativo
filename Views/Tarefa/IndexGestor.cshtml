@model List<Tarefa>

@{
    Projeto projeto = ViewBag.Projeto;

    // Separa as tarefas pelas três colunas já existentes no visual original.
    List<Tarefa> tarefasAFazer = Model.FindAll(t => t.Status == "A fazer" || t.Status == "A Fazer");
    List<Tarefa> tarefasAndamento = Model.FindAll(t => t.Status == "Em andamento");
    List<Tarefa> tarefasFinalizadas = Model.FindAll(t => t.Status == "Finalizado");
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tarefa</title>

    <!-- Ícone da aba. -->
    <link rel="icon" type="image/png" href="/imagens/logo.png">

    <!-- Mantém o mesmo CSS da primeira versão do projeto. -->
    <link rel="stylesheet" href="/css/tarefa.css" />
</head>
<body>
    <!-- ==================== CABEÇALHO ==================== -->
    <header class="cabecalho-tarefas">
        <a href="/" class="logo-tarefas">
            <img src="/imagens/logo.png" alt="Logo">
        </a>

        <!-- A rota continua sendo a rota funcional do CRUD atual. -->
        <a href="/Funcionario/Criar" class="cadastrar-funcionario">
            <img src="/imagens/criar_funcionario.png" alt="Cadastrar funcionário">
            <span>Cadastrar Funcionário</span>
        </a>

        <div class="informacoes-gestor">
            <span>Nome do Gestor</span>
            <a href="/Perfil/GestorPerfil" class="link-perfil">
                <img src="/imagens/Entrar.png" alt="Perfil do gestor">
            </a>
        </div>
    </header>

    <!-- ==================== CONTEÚDO ==================== -->
    <main class="conteudo-tarefas">
        @if (TempData["Sucesso"] != null)
        {
            <div class="mensagem-crud sucesso">@TempData["Sucesso"]</div>
        }

        @if (TempData["Erro"] != null)
        {
            <div class="mensagem-crud erro">@TempData["Erro"]</div>
        }

        <!-- Mantém o título simples, como na primeira versão visual. -->
        <div class="titulo-tarefas">
            <a href="@Url.Action("Detalhes", "Projeto", new { id = projeto.Codigo })"
               class="voltar-tarefas">
                <img src="/imagens/voltar.png" alt="Voltar">
            </a>

            <h1>Tarefas do Projeto</h1>
        </div>

        <!-- ==================== KANBAN ==================== -->
        <div class="kanban-board">
            <!-- ==================== A FAZER ==================== -->
            <section class="coluna-tarefas coluna-analise">
                <div class="cabecalho-coluna">
                    <h2>Tarefas a Fazer</h2>

                    <!-- O botão volta à posição da primeira View, mas preserva
                         o projeto atual para o cadastro funcionar corretamente. -->
                    <a href="/Tarefa/ExTarefaGestor?projetoCodigo=@projeto.Codigo"
                       class="botao-criar-tarefa">
                        + Criar Tarefa
                    </a>
                </div>

                <div class="corpo-coluna" data-status="a_fazer">
                    @if (tarefasAFazer.Count == 0)
                    {
                        <span class="sem-tarefas">Nenhuma tarefa.</span>
                    }

                    @foreach (Tarefa tarefa in tarefasAFazer)
                    {
                        <!-- O card mantém o comportamento atual de expandir na própria página,
                             mas reutiliza a aparência e os botões da primeira versão. -->
                        <div class="card-tarefa" data-tarefa="@tarefa.Titulo">
                            <details class="expansao-card-tarefa">
                                <summary class="conteudo-card">
                                <p>@tarefa.Titulo</p>

                                <span class="botao-expandir-tarefa" title="Exibir tarefa">
                                    <img src="/imagens/abrir.png" alt="Exibir tarefa">
                                </span>
                                </summary>

                                <div class="detalhes-card-tarefa">
                                <p><strong>Categoria:</strong> @tarefa.Categoria.Descricao</p>
                                <p><strong>Descrição:</strong> @tarefa.Descricao</p>
                                <p><strong>Previsão:</strong> @(tarefa.DataHoraPrevista.HasValue ? tarefa.DataHoraPrevista.Value.ToString("dd/MM/yyyy") : "Não informada")</p>
                                <p><strong>Visível ao cliente:</strong> @(tarefa.Visibilidade ? "Sim" : "Não")</p>

                                <a href="/Tarefa/ExTarefaGestor?id=@tarefa.Codigo"
                                   class="botao-editar-card">
                                    Editar / ver detalhes
                                </a>
                                </div>
                            </details>

                            <div class="acoes-card">
                                <button type="button" class="botao-compartilhar">Compartilhar</button>
                            </div>
                        </div>
                    }
                </div>
            </section>

            <!-- ==================== EM ANDAMENTO ==================== -->
            <section class="coluna-tarefas coluna-andamento">
                <div class="cabecalho-coluna">
                    <h2>Tarefas em Andamento</h2>
                </div>

                <div class="corpo-coluna" data-status="andamento">
                    @if (tarefasAndamento.Count == 0)
                    {
                        <span class="sem-tarefas">Nenhuma tarefa.</span>
                    }

                    @foreach (Tarefa tarefa in tarefasAndamento)
                    {
                        <div class="card-tarefa" data-tarefa="@tarefa.Titulo">
                            <details class="expansao-card-tarefa">
                                <summary class="conteudo-card">
                                <p>@tarefa.Titulo</p>

                                <span class="botao-expandir-tarefa" title="Exibir tarefa">
                                    <img src="/imagens/abrir.png" alt="Exibir tarefa">
                                </span>
                                </summary>

                                <div class="detalhes-card-tarefa">
                                <p><strong>Categoria:</strong> @tarefa.Categoria.Descricao</p>
                                <p><strong>Descrição:</strong> @tarefa.Descricao</p>
                                <p><strong>Início:</strong> @(tarefa.DataHoraInicio.HasValue ? tarefa.DataHoraInicio.Value.ToString("dd/MM/yyyy") : "Não informado")</p>
                                <p><strong>Previsão:</strong> @(tarefa.DataHoraPrevista.HasValue ? tarefa.DataHoraPrevista.Value.ToString("dd/MM/yyyy") : "Não informada")</p>

                                <a href="/Tarefa/ExTarefaGestor?id=@tarefa.Codigo"
                                   class="botao-editar-card">
                                    Editar / ver detalhes
                                </a>
                                </div>
                            </details>

                            <div class="acoes-card">
                                <button type="button" class="botao-compartilhar">Compartilhar</button>
                            </div>
                        </div>
                    }
                </div>
            </section>

            <!-- ==================== FINALIZADAS ==================== -->
            <section class="coluna-tarefas coluna-finalizadas">
                <div class="cabecalho-coluna">
                    <h2>Tarefas Finalizadas</h2>
                </div>

                <div class="corpo-coluna" data-status="finalizada">
                    @if (tarefasFinalizadas.Count == 0)
                    {
                        <span class="sem-tarefas">Nenhuma tarefa.</span>
                    }

                    @foreach (Tarefa tarefa in tarefasFinalizadas)
                    {
                        <div class="card-tarefa" data-tarefa="@tarefa.Titulo">
                            <details class="expansao-card-tarefa">
                                <summary class="conteudo-card">
                                <p>@tarefa.Titulo</p>

                                <span class="botao-expandir-tarefa" title="Exibir tarefa">
                                    <img src="/imagens/abrir.png" alt="Exibir tarefa">
                                </span>
                                </summary>

                                <div class="detalhes-card-tarefa">
                                <p><strong>Categoria:</strong> @tarefa.Categoria.Descricao</p>
                                <p><strong>Descrição:</strong> @tarefa.Descricao</p>
                                <p><strong>Finalizada em:</strong> @(tarefa.DataHoraFim.HasValue ? tarefa.DataHoraFim.Value.ToString("dd/MM/yyyy") : "Não informada")</p>

                                <a href="/Tarefa/ExTarefaGestor?id=@tarefa.Codigo"
                                   class="botao-editar-card">
                                    Editar / ver detalhes
                                </a>
                                </div>
                            </details>

                            <div class="acoes-card">
                                <button type="button" class="botao-compartilhar">Compartilhar</button>
                            </div>
                        </div>
                    }
                </div>
            </section>
        </div>
    </main>

</body>
</html>
