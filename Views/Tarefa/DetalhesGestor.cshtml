@model Tarefa

@{
    // Código 0 significa que o formulário está criando uma nova Tarefa (igual ao novoProjeto da tela do projeto).
    // Tarefa nova ainda não existe no banco, então ainda não pode receber comentários.
    bool novaTarefa = Model.Codigo == 0;

    // sem equipe não tem autor válido pro comentário (a FK do banco exige alguém da equipe da tarefa)
    // usado pra desabilitar o campo e o botão do chat
    bool semEquipe = Model.Funcionarios == null || Model.Funcionarios.Count() < 1;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(@Model.Codigo == 0 ? "Nova Tarefa" : "Exibição de Tarefa")</title>

    <!-- ícone da aba -->
    <link rel="icon" type="image/png" href="/imagens/logo.png">

    <!-- css específico dessa tela -->
    <link rel="stylesheet" href="/css/exibicao_tarefa.css" />
</head>
<body>
<!-- ==========================================================
     CABEÇALHO
     ========================================================== -->

<header class="cabecalho-tarefa">

    <!-- logo que volta pra home -->
  <a href="/" class="logo-tarefa">
    <img src="/imagens/logo.png" alt="Logo">
 </a>


    <!-- atalho pra cadastrar funcionário -->
    <a href="/CadastroFuncionario/CadastroFuncionario"
       class="cadastrar-funcionario">

        <img src="/imagens/criar_funcionario.png"
             alt="Cadastrar funcionário">

        <span>
            Cadastrar Funcionário
        </span>

    </a>


    <!-- informações do gestor logado -->
    <div class="informacoes-gestor">

        <span>
            Nome do Gestor
        </span>

        <!-- link pro perfil do gestor -->
        <a href="/Perfil/GestorPerfil"
           class="link-perfil">

            <img src="/imagens/Entrar.png"
                 alt="Perfil do gestor">

        </a>

    </div>

</header>


<!-- ==========================================================
     CONTEÚDO PRINCIPAL
     ========================================================== -->

<main class="conteudo-exibicao-tarefa">

    <!-- mensagem de erro do Create, Update ou Delete -->
    <!-- o ViewBag.Erro vem do catch das actions da tarefa, ou do ?erro= da url quando o comentário falha -->
    @if (ViewBag.Erro != null)
    {
        <div class="mensagem-crud erro">@ViewBag.Erro</div>
    }


    <!-- ======================================================
         FORMULÁRIO DA TAREFA
         ====================================================== -->

    <form method="post"
          id="formTarefa"
          action=@(@Model.Codigo == 0 ? "/tarefa/create" : "/tarefa/update")>
        <!-- ==================================================
             IDENTIFICAÇÃO DA TAREFA
             ================================================== -->
        <!-- código 0 = tarefa nova (o form vai pro Create); maior que 0 = tarefa existente (vai pro Update) -->
        <input type="hidden" id="codigoTarefa" name="Codigo" value="@Model.Codigo">
        <!-- ==================================================
             PROJETO DA TAREFA
             ================================================== -->
        <!-- tarefa nova: veio da url (?idProjeto=2); tarefa existente: veio do banco pelo Read -->
        <!-- o Create usa pra gravar a tarefa no projeto certo, e o Update usa pra voltar pro kanban desse projeto -->
        <input type="hidden" name="IdProjeto" value="@(Model.IdProjeto)">
        <!-- ==================================================
             LINHA SUPERIOR
             ================================================== -->

        <div class="linha-superior-tarefa">


            <!-- título da página -->

            <div class="titulo-exibicao-tarefa">

                <!-- botão de voltar pro kanban do projeto dono da tarefa (/Tarefa/IndexGestor/2) -->

                <a href="/Tarefa/IndexGestor/@Model.IdProjeto"
                   class="voltar-tarefa">

                    <img src="/imagens/voltar.png"
                         alt="Voltar">

                </a>


                <h1>
                    Exibição de Tarefa
                </h1>

            </div>


            <!-- ==================================================
                 SITUAÇÃO / STATUS DA TAREFA
                 ================================================== -->
            <!-- em tarefa nova o exibicao_tarefa.js esconde esse bloco de propósito: -->
            <!-- a tarefa nasce "A fazer" (opção que já vem selecionada) e o status só muda depois de salva -->
            <div class="situacao-tarefa"
                 id="containerSituacao">

                <span>
                    Status:
                </span>


                <!-- o status pode ser alterado aqui na mão, e é gravado quando clica em Salvar -->
                <!-- o Razor deixa selecionada a opção igual ao Model.Status -->
                <!-- os values têm que ser escritos igual ao banco e ao kanban ("A fazer", "Em andamento", "Finalizado"), -->
                <!-- senão a tarefa cai na coluna errada do kanban -->
                <select id="situacaoTarefa"
                        name="Status">
                    <option value="A fazer" selected="@(Model.Status == "A fazer" || Model.Status == "" || Model.Status == null)">
                        A Fazer
                    </option>
                    <option value="Em andamento" selected="@(Model.Status == "Em andamento")">
                        Em Andamento
                    </option>
                    <option value="Finalizado" selected="@(Model.Status == "Finalizado")">
                        Finalizada
                    </option>
                </select>

            </div>

        </div>


        <!-- ==================================================
             COLUNAS
             ================================================== -->

        <div class="colunas-tarefa">


            <!-- ==================================================
                 COLUNA ESQUERDA
                 informações da tarefa
                 ================================================== -->

            <section class="coluna-info-tarefa">


                <!-- TÍTULO DA TAREFA -->

                <div class="campo-tarefa">

                    <label for="tituloTarefa">
                        Título da Tarefa
                    </label>


                    <div class="campo-com-icone-tarefa">

                        <input type="text"
                               id="tituloTarefa"
                               name="Titulo"
                               placeholder="Título da Tarefa"
                               value="@Model.Titulo" 
                        >


                        <!-- ícone de editar -->
                        <img src="/imagens/editar.png"
                             alt="Editar">

                    </div>

                </div>


                <!-- CATEGORIA -->

                <div class="campo-tarefa">

                    <label for="categoriaTarefa">
                        Categoria
                    </label>


                    <div class="campo-com-icone-tarefa">

                        <!-- as opções vêm da ViewBag.Categorias; na tarefa existente, a categoria dela já vem selecionada -->
                        <!-- o name Categoria.Codigo preenche o objeto Categoria de dentro da Tarefa (model binding) -->
                        <select id="categoriaTarefa"
                                name="Categoria.Codigo">
                            <option value=""
                                    selected
                                    disabled>

                                Selecione uma categoria

                            </option>

                            @foreach (var categoria in ViewBag.Categorias) 
                            {
                                @if (@Model.Codigo != 0 && @Model.Categoria.Codigo == categoria.Codigo){
                                    <option value="@categoria.Codigo" selected>@categoria.Descricao</option>
                                } else {
                                    <option value="@categoria.Codigo">@categoria.Descricao</option>
                                }
                            }
                            

                        </select>

                    </div>

                </div>


                <!-- DESCRIÇÃO -->

                <div class="campo-tarefa">

                    <label for="descricaoTarefa">
                        Descrição
                    </label>


                    <div class="campo-texto-tarefa">

                        <textarea id="descricaoTarefa"
                                  name="Descricao"
                                  placeholder="Texto.."
                        >@Model.Descricao</textarea>


                        <!-- ícone de editar -->
                        <img src="/imagens/editar.png"
                             alt="Editar">

                    </div>

                </div>


                <!-- CAMPO DE COMENTÁRIOS -->
                <!-- mostra o último comentário (o js copia da última mensagem do chat, que foi montado no C#) -->
                <!-- a conversa completa fica no modal, que abre clicando no campo ou no lápis -->
                <div class="campo-tarefa">
                    <label for="comentariosTarefa">Comentários</label>

                    @if (novaTarefa)
                    {
                        <!-- tarefa nova: no lugar do campo, um aviso (igual ao "Salve o projeto antes..." do projeto) -->
                        <p class="aviso-comentarios-tarefa">Salve a tarefa antes de comentar.</p>
                    }
                    else
                    {
                        <div class="campo-com-icone-tarefa campo-comentarios-chat">
                            <input type="text"
                                id="comentariosTarefa"
                                placeholder="Nenhum comentário ainda"
                                readonly
                                title="Último comentário"
                                value="">

                            <!-- o lápis abre a conversa completa -->
                            <img src="/imagens/editar.png"
                                alt="Abrir comentários"
                                id="iconeComentarios"
                                title="Abrir conversa">
                        </div>
                    }
                </div>


            </section>


            <!-- ==================================================
                 COLUNA CENTRAL
                 prazos e funcionários
                 ================================================== -->

            <section class="coluna-prazos-tarefa">


                <!-- DATA DE INÍCIO -->

                <div class="campo-tarefa">

                    <label for="dataInicio">
                        Data de Início
                    </label>


                    <div class="campo-com-icone-tarefa">

                        <input type="date"
                               id="dataInicio"
                               name="DataHoraInicio"
                               value="@Model.DataHoraInicio?.ToString("yyyy-MM-dd")">

                    </div>

                </div>


                <!-- PREVISÃO DE TÉRMINO -->

                <div class="campo-tarefa">

                    <label for="previsaoTermino">
                        Previsão de Término
                    </label>


                    <div class="campo-com-icone-tarefa">

                        <input type="date"
                               id="previsaoTermino"
                               name="DataHoraPrevista"
                               value="@Model.DataHoraPrevista?.ToString("yyyy-MM-dd")">


                    </div>

                </div>


                <!-- DATA DE ENTREGA -->

                <div class="campo-tarefa">

                    <label for="dataEntrega">
                        Data de Entrega
                    </label>


                    <div class="campo-com-icone-tarefa">

                        <input type="date"
                               id="dataEntrega"
                               name="DataHoraFim"
                               value="@Model.DataHoraFim?.ToString("yyyy-MM-dd")">

                    </div>

                </div>


                <!-- FUNCIONÁRIOS -->

                <h2 class="titulo-funcionarios">
                    Funcionário(s):
                </h2>


                <!-- área onde aparece a equipe atual da tarefa (Model.Funcionarios, que vem do Read) -->
                <!-- pra mudar a equipe é pelo modal do +, e a mudança só é gravada quando clica em Salvar -->
                <div class="area-funcionarios">

                        @if (@Model.Funcionarios != null && @Model.Funcionarios.Count() > 0)
                        {
                             @foreach (var funcionario in @Model.Funcionarios)
                            {
                                <div class="funcionario">
                                    <img src="/imagens/Entrar.png"
                                         alt="Funcionário"
                                         class="icone-funcionario">


                                    <span>
                                        @funcionario.Nome - @funcionario.Cargo.Descricao
                                    </span>
                                </div>
                                }
                        } else
                        {
                            <span>Ainda não há funcionários para essa tarefa...</span>
                        }


                </div>


                <!-- BOTÕES DOS FUNCIONÁRIOS -->

                <div class="acoes-funcionarios">


                    <!-- botão de baixar -->

                    <button type="button"
                            class="botao-download-funcionario"
                            title="Baixar">
                    </button>


                    <!-- botão que abre o modal pra adicionar funcionário -->

                    <button type="button"
                            class="botao-adicionar-funcionario"
                            title="Adicionar funcionário">

                        +

                    </button>

                </div>

            </section>


            <!-- ==================================================
                 COLUNA DIREITA
                 arquivos
                 ================================================== -->

            <section class="coluna-arquivos-tarefa">


                <h2>
                    Arquivos:
                </h2>


                <div class="area-arquivos">
                    @if (Model.Documentos != null && Model.Documentos.Count() > 0)
                    {
                        @foreach (var documento in Model.Documentos)
                        {
                            <div class="arquivo">

                                <img src="/imagens/documento.png"
                                     alt="@documento.Extensao"
                                     class="icone-arquivo">
                                     
                                <!-- title: o nome completo aparece ao passar o mouse, já que o CSS corta com "..." -->
                                <span class="nome-arquivo"
                                      title="@($"{documento.Descricao}.{documento.Extensao}")">
                                    @($"{documento.Descricao}.{documento.Extensao}")
                                </span>

                                <!-- botão que abre o arquivo -->
                                <a href="@documento.Diretorio"
                                   target="_blank"
                                   class="botao-abrir-arquivo"
                                   title="Abrir arquivo">
                                    <img src="/imagens/abrir.png" alt="Abrir">
                                </a>

                                <!-- botão que exclui o arquivo -->
                                <!-- form="formExcluirDocumento-X": envia o form de exclusão desse documento (lá embaixo, fora do form da tarefa) -->
                                <!-- o confirm pergunta antes; se clicar em "Cancelar", o return false impede o envio -->
                                <button type="submit"
                                        form="formExcluirDocumento-@documento.Codigo"
                                        class="botao-excluir-arquivo"
                                        title="Excluir arquivo"
                                        onclick="return confirm('Tem certeza que deseja excluir este arquivo?')">
                                    <img src="/imagens/excluir_arquivo.png" alt="Excluir">
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <span>Ainda não há arquivos para essa tarefa...</span>
                    }

                </div>


                <!-- botão de adicionar arquivo -->
                @if (!novaTarefa)
                {    
                    <div class="acoes-arquivos">
                        <input type="file" 
                               id="arquivoTarefa" 
                               name="arquivo" 
                               form="formUploadDocumento"
                               style="display: none"
                               onchange="this.form.submit()">

                        <button type="button"
                                class="botao-adicionar-arquivo"
                                title="Adicionar arquivo"
                                onclick="document.getElementById('arquivoTarefa').click()">
                            +
                        </button>
                    </div>
                }

                <!-- a visibilidade ainda não tem campo na tela: o hidden devolve o mesmo valor que veio do banco, -->
                <!-- pro Update não trocar sem querer (tarefa nova vai com false) -->
                <input type="hidden" name="Visibilidade" value="@(Model.Visibilidade ? "true" : "false")">



            </section>

        </div>


        <!-- ==================================================
             BOTÃO SALVAR
             ================================================== -->

        @if (@Model.Codigo == 0) // Create
        {
            <div class="acoes-exibicao-tarefa">
                <button type="submit"
                        class="botao-salvar-tarefa">
                    Nova Tarefa
                </button>
            </div>
        } else {
            <div class="acoes-exibicao-tarefa">
                <button type="button"
                        class="botao-excluir-tarefa"
                        onclick="confirmarExclusaoTarefa()">
                    Excluir tarefa
                </button>

                <button type="submit"
                        class="botao-salvar-tarefa">
                    Salvar
                </button>
            </div>
        }

    </form>


    <!-- ==========================================================
         MODAL DE FUNCIONÁRIOS
         ========================================================== -->

    <!-- sobreposição que aparece quando clica no + de funcionário -->
    <div class="modal-funcionarios"
         id="modalFuncionarios">


        <!-- caixa do modal -->

        <div class="caixa-modal-funcionarios">


            <!-- botão de fechar -->

            <button type="button"
                    class="fechar-modal-funcionarios"
                    id="fecharModalFuncionarios">

                X

            </button>


            <!-- cabeçalho do modal -->

            <div class="cabecalho-modal">

                <h2>
                    O projeto foi Aprovado!
                </h2>


                <p>
                    Selecione um ou mais integrantes
                    para a realização dessa tarefa:
                </p>

            </div>


            <!-- lista de funcionários disponíveis -->

            <div class="lista-funcionarios">


                <!-- um item pra cada funcionário ativo (ViewBag.Funcionarios) -->
                <!-- quem já está na equipe da tarefa (naEquipe) vem marcado -->
                <!-- os inputs ficam aqui fora do form, mas o atributo form="formTarefa" faz eles serem enviados junto com a tarefa -->



                    @if (@ViewBag.Funcionarios.Count > 0) 
                    {
                        @foreach(var func in @ViewBag.Funcionarios) {
                            bool naEquipe = Model.Funcionarios != null && Model.Funcionarios.Any(f => f.Codigo == func.Codigo);
                            
                            <label class="funcionario-item @(naEquipe ? "selecionado" : "")">
                                <div class="informacoes-funcionario">
                                    <img src="/imagens/entrar.png" alt="Funcionário">
                                    <div>
                                        <strong>@func.Nome</strong>
                                        <span>@func.Cargo.Descricao</span>
                                    </div>
                                </div>

                                <!-- marcado = entra na lista; o value diz QUAL índice do hidden abaixo deve ser lido -->
                                <input type="checkbox"
                                    form="formTarefa"
                                    name="Funcionarios.Index"
                                    value="@func.Codigo"
                                    checked="@naEquipe"
                                    style="display:none">

                                <!-- o código que vai pro objeto; só é lido se o checkbox acima estiver marcado -->
                                <input type="hidden"
                                    form="formTarefa"
                                    name="Funcionarios[@func.Codigo].Codigo"
                                    value="@func.Codigo"
                                    style="display:none">

                                <!-- botão pra selecionar -->
                                <button type="button" class="botao-selecionar-funcionario">+</button>

                            </label>
                        }
                    }
                    

            </div>


            <!-- botões do modal -->

            <div class="botoes-modal-funcionarios">


                <!-- cancelar -->

                <!--<button type="button"
                        class="botao-cancelar-funcionario"
                        id="cancelarFuncionarios">

                    Cancelar

                </button>-->


                <!-- confirmar -->

                <button type="button"
                        class="botao-confirmar-funcionario"
                        id="confirmarFuncionarios">

                    Confirmar

                </button>

            </div>

        </div>

    </div>

</main>

<!-- form próprio do upload: fora do form da tarefa, porque form dentro de form não é permitido -->
<!-- enctype="multipart/form-data" é obrigatório pra enviar arquivo -->
<!-- não tem campo de arquivo aqui dentro: o input do botão "+" se liga a ele pelo form="formUploadDocumento" -->
@if (!novaTarefa)
{
    <form id="formUploadDocumento"
          method="post"
          action="/Documento/Create"
          enctype="multipart/form-data">
        <input type="hidden" name="idTarefa" value="@Model.Codigo">
    </form>
}

<!-- um form de exclusão pra cada documento, também fora do form da tarefa -->
<!-- o botão de lixeira de cada arquivo aponta pro seu form pelo id (formExcluirDocumento-X) -->
<!-- só vai o código do documento: o caminho do arquivo no disco o controller busca no banco -->
@if (Model.Documentos != null)
{
    @foreach (var documento in Model.Documentos)
    {
        <form id="formExcluirDocumento-@documento.Codigo"
              method="post"
              action="/Documento/Delete">
            <input type="hidden" name="id" value="@documento.Codigo">
            <input type="hidden" name="idTarefa" value="@Model.Codigo">
        </form>
    }
}

<div id="modalExclusaoTarefa" class="modal-exclusao">
    <div class="caixa-exclusao">
        <h2>Excluir tarefa?</h2>

        <p>Tem certeza que deseja excluir esta tarefa?</p>

        <div class="acoes-exclusao">
            <button type="button"
                    class="botao-voltar-tarefa"
                    onclick="fecharModalExclusao()">
                Voltar para tarefa
            </button>

            <!-- form próprio da exclusão: fica fora do form da tarefa, porque form dentro de form não é permitido -->
            <!-- os dois códigos vêm do @Model e vão pros parâmetros id e idProjeto da action Delete -->
            <form method="post" action="/Tarefa/Delete">
                <input type="hidden" name="id" value="@Model.Codigo">
                <input type="hidden" name="idProjeto" value="@Model.IdProjeto">

                <button type="submit"
                        class="botao-confirmar-exclusao">
                    Excluir tarefa
                </button>
            </form>
        </div>
    </div>
</div>
<!-- ==========================================================
     MODAL DE COMENTÁRIOS - CHAT
     só existe pra tarefa já salva: tarefa nova não tem código pra ligar o comentário
     (o js do chat checa se cada elemento existe, então não precisa mudar nada nele)
     ========================================================== -->
@if (!novaTarefa)
{
<div id="modalComentarios" class="modal-comentarios">
    <div class="caixa-chat">

        <div class="cabecalho-chat">
            <div>
                <h2>Comentários da tarefa</h2>
                <span>Conversa entre os participantes</span>
            </div>
            <button type="button" id="fecharChat" class="fechar-chat">×</button>
        </div>

        <!-- as mensagens vêm do banco (Model.Comentarios, do mais antigo pro mais novo), montadas pelo C# -->
        <!-- o js não cria mensagem nenhuma: depois de enviar, a página recarrega e o comentário novo aparece aqui -->
        <div id="mensagensChat" class="mensagens-chat">
            @if (@Model.Comentarios != null && @Model.Comentarios.Count() > 0) {
                @foreach (var comentario in @Model.Comentarios)
                {
                    <div class="mensagem mensagem-outra">
                        <span class="nome-mensagem">(@comentario.Funcionario.Nome)</span>
                        <p>@comentario.Descricao</p>
                        <span class="horario-mensagem">@comentario.DataHora.ToString("dd/MM HH:mm")</span>
                    </div>
                }
            }
        </div>

        <!-- envia o comentário pra action Create do ComentarioController -->
        <!-- os nomes dos campos são os nomes das propriedades da model Comentario (model binding) -->
        <form id="formularioChat" class="formulario-chat"
              method="post" action="/Comentario/Create">

            <!-- tarefa dona do comentário -->
            <input type="hidden" name="IdTarefa" value="@Model.Codigo">

            <!-- autor provisório: o primeiro funcionário da equipe (em ordem alfabética), enquanto não existe login -->
            <!-- atenção: o banco só aceita se esse funcionário estiver na equipe da tarefa -->
            <!-- se der erro, o ComentarioController volta pra cá com ?erro= na url e a mensagem aparece no topo da tela -->
            <input type="hidden" name="Funcionario.Codigo" value="@(semEquipe ? 0 : Model.Funcionarios[0].Codigo)">

            <!-- disabled="@semEquipe": igual ao selected/checked, com false o razor nem escreve o atributo -->
            <input type="text" id="novoComentario"
                   name="Descricao"
                   placeholder="@(semEquipe ? "Adicione alguém à equipe para comentar" : "Digite seu comentário...")"
                   autocomplete="off" maxlength="500" required
                   disabled="@semEquipe">
            <button type="submit" class="enviar-comentario" disabled="@semEquipe">Enviar</button>
        </form>

    </div>
</div>
}

<!-- js específico dessa tela -->
<script src="/js/exibicao_tarefa.js"></script>
</body>