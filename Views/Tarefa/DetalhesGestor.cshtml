@model Tarefa

@{
    bool novaTarefa = Model.Codigo == 0;

    // O Repository devolve os comentários ordenados por data.
    // Usamos o último apenas como resumo visual no campo de comentários.
    Comentario? ultimoComentario = null;
    if (Model.Comentarios != null && Model.Comentarios.Count > 0)
    {
        ultimoComentario = Model.Comentarios[Model.Comentarios.Count - 1];
    }
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(novaTarefa ? "Nova Tarefa" : "Exibição de Tarefa")</title>

    <link rel="icon" type="image/png" href="/imagens/logo.png">
    <link rel="stylesheet" href="/css/exibicao_tarefa.css" />
</head>
<body>
    <!-- ==========================================================
         CABEÇALHO
         ========================================================== -->
    <header class="cabecalho-tarefa">
        <a href="/" class="logo-tarefa">
            <img src="/imagens/logo.png" alt="Logo">
        </a>

        <!-- Mantém a rota funcional da versão atual. -->
        <a href="/Funcionario/Criar" class="cadastrar-funcionario">
            <img src="/imagens/criar_funcionario.png" alt="Cadastrar funcionário">
            <span>Cadastrar Funcionário</span>
        </a>

        <div class="informacoes-gestor">
            <span>Nome do Gestor</span>
            <a href="/Perfil/GestorPerfil" class="link-perfil">
                <img src="/imagens/Entrar.png" alt="Perfil do gestor">
            </a>
        </div>
    </header>

    <!-- ==========================================================
         CONTEÚDO PRINCIPAL
         ========================================================== -->
    <main class="conteudo-exibicao-tarefa">
        @if (TempData["Erro"] != null)
        {
            <div class="mensagem-crud erro">@TempData["Erro"]</div>
        }

        <!-- O mesmo formulário atende criação e alteração. -->
        <form id="formTarefa" method="post" action="/Tarefa/Salvar">
            <input type="hidden" name="Codigo" value="@Model.Codigo">
            <input type="hidden" name="IdProjeto" value="@Model.IdProjeto">

            <!-- ==================================================
                 LINHA SUPERIOR
                 ================================================== -->
            <div class="linha-superior-tarefa">
                <div class="titulo-exibicao-tarefa">
                    <a href="/Tarefa/GestorTarefa?id=@Model.IdProjeto" class="voltar-tarefa">
                        <img src="/imagens/voltar.png" alt="Voltar">
                    </a>

                    <h1>@(novaTarefa ? "Criar Tarefa" : "Exibição de Tarefa")</h1>
                </div>

                <!-- Na primeira versão o status não aparecia durante a criação.
                     Mantemos essa aparência sem alterar o valor enviado ao banco. -->
                <div class="situacao-tarefa @(novaTarefa ? "situacao-nova-tarefa" : "")"
                     id="containerSituacao">
                    <span>Status:</span>

                    <select id="situacaoTarefa" name="Status">
                        @if (Model.Status == "A fazer" || Model.Status == "A Fazer")
                        {
                            <option value="A fazer" selected>A Fazer</option>
                        }
                        else
                        {
                            <option value="A fazer">A Fazer</option>
                        }

                        @if (Model.Status == "Em andamento")
                        {
                            <option value="Em andamento" selected>Em Andamento</option>
                        }
                        else
                        {
                            <option value="Em andamento">Em Andamento</option>
                        }

                        @if (Model.Status == "Finalizado")
                        {
                            <option value="Finalizado" selected>Finalizada</option>
                        }
                        else
                        {
                            <option value="Finalizado">Finalizada</option>
                        }
                    </select>
                </div>
            </div>

            <!-- ==================================================
                 COLUNAS
                 ================================================== -->
            <div class="colunas-tarefa">
                <!-- ==================================================
                     COLUNA ESQUERDA - informações da tarefa
                     ================================================== -->
                <section class="coluna-info-tarefa">
                    <div class="campo-tarefa">
                        <label for="tituloTarefa">Título da Tarefa</label>

                        <div class="campo-com-icone-tarefa">
                            <input type="text"
                                   id="tituloTarefa"
                                   name="Titulo"
                                   maxlength="50"
                                   required
                                   placeholder="Título da Tarefa"
                                   value="@Model.Titulo">
                            <img src="/imagens/editar.png" alt="Editar">
                        </div>
                    </div>

                    <div class="campo-tarefa">
                        <label for="categoriaTarefa">Categoria</label>

                        <div class="campo-com-icone-tarefa">
                            <select id="categoriaTarefa" name="CategoriaCodigo" required>
                                <option value="">Selecione uma categoria</option>

                                @foreach (Categoria categoria in ViewBag.Categorias)
                                {
                                    if (Model.Categoria.Codigo == categoria.Codigo)
                                    {
                                        <option value="@categoria.Codigo" selected>@categoria.Descricao</option>
                                    }
                                    else
                                    {
                                        <option value="@categoria.Codigo">@categoria.Descricao</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="campo-tarefa">
                        <label for="descricaoTarefa">Descrição</label>

                        <div class="campo-texto-tarefa">
                            <textarea id="descricaoTarefa"
                                      name="Descricao"
                                      required
                                      placeholder="Texto..">@Model.Descricao</textarea>
                            <img src="/imagens/editar.png" alt="Editar">
                        </div>
                    </div>

                    <!-- Comentários voltam à posição da primeira View.
                         Eles continuam pertencendo à Tarefa e são carregados pelo Repository. -->
                    <div class="campo-tarefa">
                        <label for="comentariosTarefa">Comentários</label>

                        <div class="campo-com-icone-tarefa campo-comentarios-chat">
                            <input type="text"
                                   id="comentariosTarefa"
                                   placeholder="Nenhum comentário ainda"
                                   readonly
                                   title="Último comentário"
                                   value="@(ultimoComentario != null ? ultimoComentario.Descricao : "")">

                            <img src="/imagens/editar.png"
                                 alt="Abrir comentários"
                                 id="iconeComentarios"
                                 title="Abrir comentários">
                        </div>
                    </div>

                    <!-- Visibilidade continua disponível porque já faz parte do banco
                         e da versão funcional atual. -->
                    <div class="campo-tarefa campo-visibilidade">
                        <label for="visibilidadeTarefa">Visível para o cliente</label>
                        <div>
                            @if (Model.Visibilidade)
                            {
                                <input type="checkbox"
                                       id="visibilidadeTarefa"
                                       name="Visibilidade"
                                       value="true"
                                       checked>
                            }
                            else
                            {
                                <input type="checkbox"
                                       id="visibilidadeTarefa"
                                       name="Visibilidade"
                                       value="true">
                            }

                            <!-- Garante false quando o checkbox não estiver marcado. -->
                            <input type="hidden" name="Visibilidade" value="false">
                        </div>
                    </div>
                </section>

                <!-- ==================================================
                     COLUNA CENTRAL - prazos e funcionários
                     ================================================== -->
                <section class="coluna-prazos-tarefa">
                    <div class="campo-tarefa">
                        <label for="dataInicio">Data/Hora de Início</label>
                        <div class="campo-com-icone-tarefa">
                            <input type="datetime-local"
                                   id="dataInicio"
                                   name="DataHoraInicio"
                                   value="@(Model.DataHoraInicio.HasValue ? Model.DataHoraInicio.Value.ToString("yyyy-MM-ddTHH:mm") : "")">
                        </div>
                    </div>

                    <div class="campo-tarefa">
                        <label for="previsaoTermino">Previsão de Término</label>
                        <div class="campo-com-icone-tarefa">
                            <input type="datetime-local"
                                   id="previsaoTermino"
                                   name="DataHoraPrevista"
                                   value="@(Model.DataHoraPrevista.HasValue ? Model.DataHoraPrevista.Value.ToString("yyyy-MM-ddTHH:mm") : "")">
                        </div>
                    </div>

                    <div class="campo-tarefa">
                        <label for="dataEntrega">Data/Hora de Entrega</label>
                        <div class="campo-com-icone-tarefa">
                            <input type="datetime-local"
                                   id="dataEntrega"
                                   name="DataHoraFim"
                                   value="@(Model.DataHoraFim.HasValue ? Model.DataHoraFim.Value.ToString("yyyy-MM-ddTHH:mm") : "")">
                        </div>
                    </div>

                    <h2 class="titulo-funcionarios">Funcionário(s):</h2>

                    <div class="area-funcionarios">
                        @if (Model.Funcionarios != null && Model.Funcionarios.Count > 0)
                        {
                            @foreach (Funcionario funcionario in Model.Funcionarios)
                            {
                                <div class="funcionario">
                                    <img src="/imagens/Entrar.png" alt="Funcionário" class="icone-funcionario">
                                    <span>@funcionario.Nome - @funcionario.Cargo.Descricao</span>
                                </div>
                            }
                        }
                        else
                        {
                            <span>Ainda não há funcionários para essa tarefa...</span>
                        }
                    </div>

                    <div class="acoes-funcionarios">
                        <button type="button"
                                class="botao-adicionar-funcionario"
                                id="abrirModalFuncionarios"
                                title="Adicionar funcionário">
                            +
                        </button>
                    </div>
                </section>

                <!-- ==================================================
                     COLUNA DIREITA - arquivos
                     ================================================== -->
                <section class="coluna-arquivos-tarefa">
                    <h2>Arquivos:</h2>

                    <div class="area-arquivos">
                        @if (Model.Documentos != null && Model.Documentos.Count > 0)
                        {
                            @foreach (Documento documento in Model.Documentos)
                            {
                                <div class="arquivo">
                                    <img src="/imagens/documento.png" alt="@documento.Extensao" class="icone-arquivo">

                                    <span class="nome-arquivo">
                                        @($"{documento.Descricao}.{documento.Extensao}")
                                    </span>

                                    <a href="@documento.Diretorio"
                                       target="_blank"
                                       class="botao-abrir-arquivo"
                                       title="Abrir arquivo">
                                        <img src="/imagens/abrir.png" alt="Abrir">
                                    </a>
                                </div>
                            }
                        }
                        else
                        {
                            <span>Ainda não há arquivos para essa tarefa...</span>
                        }
                    </div>
                </section>
            </div>

            <!-- ==================================================
                 AÇÕES
                 ================================================== -->
            <div class="acoes-exibicao-tarefa">
                @if (!novaTarefa)
                {
                    <!-- O botão aparece ao lado do Salvar como na primeira View,
                         mas envia um formulário próprio para não misturar operações. -->
                    <button type="submit"
                            form="formExcluirTarefa"
                            class="botao-excluir-tarefa"
                            onclick="return confirm('Tem certeza que deseja excluir esta tarefa?');">
                        Excluir tarefa
                    </button>
                }

                <button type="submit" class="botao-salvar-tarefa">
                    @(novaTarefa ? "Criar Tarefa" : "Salvar Alterações")
                </button>
            </div>
        </form>

        <!-- Formulário separado usado apenas pelo botão de exclusão acima. -->
        @if (!novaTarefa)
        {
            <form id="formExcluirTarefa" method="post" action="/Tarefa/Excluir">
                <input type="hidden" name="id" value="@Model.Codigo">
                <input type="hidden" name="projetoCodigo" value="@Model.IdProjeto">
            </form>
        }

        <!-- ==========================================================
             MODAL DE FUNCIONÁRIOS
             ========================================================== -->
        <div class="modal-funcionarios" id="modalFuncionarios">
            <div class="caixa-modal-funcionarios">
                <button type="button"
                        class="fechar-modal-funcionarios"
                        id="fecharModalFuncionarios">
                    X
                </button>

                <div class="cabecalho-modal">
                    <h2>Selecionar funcionários</h2>
                    <p>Selecione um ou mais integrantes para a realização dessa tarefa:</p>
                </div>

                <div class="lista-funcionarios">
                    @foreach (Funcionario funcionario in ViewBag.FuncionariosDisponiveis)
                    {
                        bool selecionado = Model.Funcionarios != null && Model.Funcionarios.Exists(f => f.Codigo == funcionario.Codigo);

                        // Inativos só continuam visíveis quando já pertencem à tarefa.
                        if (!funcionario.Ativo && !selecionado)
                        {
                            continue;
                        }

                        <label class="funcionario-item @(selecionado ? "selecionado" : "")">
                            <div class="informacoes-funcionario">
                                <img src="/imagens/Entrar.png" alt="Funcionário">

                                <div>
                                    <strong>@funcionario.Nome</strong>
                                    <span>@funcionario.Cargo.Descricao@(!funcionario.Ativo ? " - Inativo" : "")</span>
                                </div>
                            </div>

                            @if (selecionado)
                            {
                                <input type="checkbox"
                                       class="checkbox-funcionario"
                                       name="FuncionariosSelecionados"
                                       value="@funcionario.Codigo"
                                       form="formTarefa"
                                       checked>
                            }
                            else
                            {
                                <input type="checkbox"
                                       class="checkbox-funcionario"
                                       name="FuncionariosSelecionados"
                                       value="@funcionario.Codigo"
                                       form="formTarefa">
                            }
                        </label>
                    }
                </div>

                <div class="botoes-modal-funcionarios">
                    <button type="button"
                            class="botao-confirmar-funcionario"
                            id="confirmarFuncionarios">
                        Confirmar
                    </button>
                </div>
            </div>
        </div>
    </main>

    <!-- ==========================================================
         MODAL DE COMENTÁRIOS
         ========================================================== -->
    <!-- Comentários continuam dentro da Tarefa; este modal é apenas
         uma forma visual de exibir a conversa completa. -->
    <div id="modalComentarios" class="modal-comentarios">
        <div class="caixa-chat">
            <div class="cabecalho-chat">
                <div>
                    <h2>Comentários da tarefa</h2>
                    <span>Conversa entre os participantes</span>
                </div>

                <button type="button" id="fecharChat" class="fechar-chat">×</button>
            </div>

            <div id="mensagensChat" class="mensagens-chat">
                @if (Model.Comentarios != null && Model.Comentarios.Count > 0)
                {
                    @foreach (Comentario comentario in Model.Comentarios)
                    {
                        <div class="mensagem mensagem-outra">
                            <span class="nome-mensagem">@comentario.Funcionario.Nome</span>
                            <p>@comentario.Descricao</p>
                            <span class="horario-mensagem">@comentario.DataHora.ToString("dd/MM HH:mm")</span>
                        </div>
                    }
                }
                else
                {
                    <div class="mensagem mensagem-outra">
                        <p>Ainda não há comentários para esta tarefa.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <script src="/js/exibicao_tarefa.js"></script>
</body>
</html>
