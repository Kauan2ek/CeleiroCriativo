@model Tarefa

<!-- tela da tarefa pro cliente: só leitura -->
<!-- o cliente vê tudo da tarefa (dados, equipe, arquivos e comentários), mas não altera nada -->
<!-- a action DetalhesCliente só deixa chegar aqui tarefa visível (Visibilidade = true) de projeto do próprio cliente -->

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Exibição de Tarefa</title>

    <!-- ícone da aba -->
    <link rel="icon" type="image/png" href="/imagens/logo.png">

    <!-- css específico dessa tela (o mesmo da tela do gestor) -->
    <link rel="stylesheet" href="/css/exibicao_tarefa.css" />
</head>
<body>
<!-- ==========================================================
     CABEÇALHO
     ========================================================== -->

<header class="cabecalho-tarefa">

    <!-- logo que volta pra home -->
    <a href="/" class="logo-tarefa">
        <img src="/imagens/logo.png" alt="Logo">
    </a>


    <!-- informações do cliente logado (o nome vem da sessão, gravada no login) -->
    <div class="informacoes-funcionario">

        <span>
            @Context.Session.GetString("nome")
        </span>

        <!-- link pro perfil do cliente -->
        <a href="/Perfil/ClientePerfil"
           class="link-perfil">

            <img src="/imagens/Entrar.png"
                 alt="Perfil do cliente">

        </a>

    </div>

</header>


<!-- ==========================================================
     CONTEÚDO PRINCIPAL
     ========================================================== -->

<main class="conteudo-exibicao-tarefa">

    <!-- o form não tem action nem botão de enviar: ele só mantém a mesma estrutura (e o mesmo visual) da tela do gestor -->
    <!-- todos os campos estão disabled, então o cliente só lê -->
    <form id="formTarefa">

        <!-- o exibicao_tarefa.js usa esse código pra saber que não é tarefa nova (e mostrar o status) -->
        <input type="hidden" id="codigoTarefa" value="@Model.Codigo">

        <!-- ==================================================
             LINHA SUPERIOR
             ================================================== -->

        <div class="linha-superior-tarefa">


            <!-- título da página -->

            <div class="titulo-exibicao-tarefa">

                <!-- botão de voltar pro kanban do projeto dono da tarefa (/Tarefa/IndexCliente/2) -->
                <a href="/Tarefa/IndexCliente/@Model.IdProjeto"
                   class="voltar-tarefa">

                    <img src="/imagens/voltar.png"
                         alt="Voltar">

                </a>


                <h1>
                    Exibição de Tarefa
                </h1>

            </div>


            <!-- ==================================================
                 SITUAÇÃO / STATUS DA TAREFA
                 ================================================== -->

            <div class="situacao-tarefa"
                 id="containerSituacao">

                <span>
                    Status:
                </span>

                <!-- disabled: o cliente vê o status, mas não muda -->
                <select id="situacaoTarefa"
                        disabled>
                    <option value="A fazer" selected="@(Model.Status == "A fazer")">
                        A Fazer
                    </option>
                    <option value="Em andamento" selected="@(Model.Status == "Em andamento")">
                        Em Andamento
                    </option>
                    <option value="Finalizado" selected="@(Model.Status == "Finalizado")">
                        Finalizada
                    </option>
                </select>

            </div>

        </div>


        <!-- ==================================================
             COLUNAS
             ================================================== -->

        <div class="colunas-tarefa">


            <!-- ==================================================
                 COLUNA ESQUERDA
                 informações da tarefa
                 ================================================== -->

            <section class="coluna-info-tarefa">


                <!-- TÍTULO DA TAREFA -->

                <div class="campo-tarefa">

                    <label for="tituloTarefa">
                        Título da Tarefa
                    </label>

                    <div class="campo-com-icone-tarefa">

                        <input type="text"
                               id="tituloTarefa"
                               value="@Model.Titulo"
                               disabled>

                    </div>

                </div>


                <!-- CATEGORIA -->

                <div class="campo-tarefa">

                    <label for="categoriaTarefa">
                        Categoria
                    </label>

                    <div class="campo-com-icone-tarefa">

                        <!-- só a categoria da tarefa: como o cliente não troca, não precisa da lista inteira (ViewBag.Categorias) -->
                        <select id="categoriaTarefa"
                                disabled>
                            <option selected>@Model.Categoria.Descricao</option>
                        </select>

                    </div>

                </div>


                <!-- DESCRIÇÃO -->

                <div class="campo-tarefa">

                    <label for="descricaoTarefa">
                        Descrição
                    </label>

                    <div class="campo-texto-tarefa">

                        <textarea id="descricaoTarefa"
                                  disabled
                        >@Model.Descricao</textarea>

                    </div>

                </div>


                <!-- CAMPO DE COMENTÁRIOS -->
                <!-- mostra o último comentário (o js copia da última mensagem do chat, que foi montado no C#) -->
                <!-- clicando no campo ou no ícone, abre a conversa completa (só pra ler) -->
                <div class="campo-tarefa">
                    <label for="comentariosTarefa">Comentários</label>

                    <div class="campo-com-icone-tarefa campo-comentarios-chat">
                        <input type="text"
                            id="comentariosTarefa"
                            placeholder="Nenhum comentário ainda"
                            readonly
                            title="Último comentário"
                            value="">

                        <img src="/imagens/editar.png"
                            alt="Abrir comentários"
                            id="iconeComentarios"
                            title="Abrir conversa">
                    </div>
                </div>

            </section>


            <!-- ==================================================
                 COLUNA CENTRAL
                 prazos e funcionários
                 ================================================== -->

            <section class="coluna-prazos-tarefa">


                <!-- DATA DE INÍCIO -->

                <div class="campo-tarefa">

                    <label for="dataInicio">
                        Data de Início
                    </label>

                    <div class="campo-com-icone-tarefa">

                        <input type="date"
                               id="dataInicio"
                               value="@Model.DataHoraInicio?.ToString("yyyy-MM-dd")"
                               disabled>

                    </div>

                </div>


                <!-- PREVISÃO DE TÉRMINO -->

                <div class="campo-tarefa">

                    <label for="previsaoTermino">
                        Previsão de Término
                    </label>

                    <div class="campo-com-icone-tarefa">

                        <input type="date"
                               id="previsaoTermino"
                               value="@Model.DataHoraPrevista?.ToString("yyyy-MM-dd")"
                               disabled>

                    </div>

                </div>


                <!-- DATA DE ENTREGA -->

                <div class="campo-tarefa">

                    <label for="dataEntrega">
                        Data de Entrega
                    </label>

                    <div class="campo-com-icone-tarefa">

                        <input type="date"
                               id="dataEntrega"
                               value="@Model.DataHoraFim?.ToString("yyyy-MM-dd")"
                               disabled>

                    </div>

                </div>


                <!-- FUNCIONÁRIOS -->

                <h2 class="titulo-funcionarios">
                    Funcionário(s):
                </h2>

                <!-- equipe da tarefa, só pra o cliente saber quem está cuidando dela -->
                <div class="area-funcionarios">

                    @if (Model.Funcionarios != null && Model.Funcionarios.Count() > 0)
                    {
                        @foreach (var funcionario in Model.Funcionarios)
                        {
                            <div class="funcionario">
                                <img src="/imagens/Entrar.png"
                                     alt="Funcionário"
                                     class="icone-funcionario">

                                <span>
                                    @funcionario.Nome - @funcionario.Cargo.Descricao
                                </span>
                            </div>
                        }
                    }
                    else
                    {
                        <span>Ainda não há funcionários para essa tarefa...</span>
                    }

                </div>

            </section>


            <!-- ==================================================
                 COLUNA DIREITA
                 arquivos
                 ================================================== -->

            <section class="coluna-arquivos-tarefa">

                <h2>
                    Arquivos:
                </h2>

                <!-- o cliente abre/baixa os arquivos, mas não envia nem exclui -->
                <div class="area-arquivos">
                    @if (Model.Documentos != null && Model.Documentos.Count() > 0)
                    {
                        @foreach (var documento in Model.Documentos)
                        {
                            <div class="arquivo">

                                <img src="/imagens/documento.png"
                                     alt="@documento.Extensao"
                                     class="icone-arquivo">

                                <span class="nome-arquivo"
                                      title="@($"{documento.Descricao}.{documento.Extensao}")">
                                    @($"{documento.Descricao}.{documento.Extensao}")
                                </span>

                                <!-- botão que abre o arquivo -->
                                <a href="@documento.Diretorio"
                                   target="_blank"
                                   class="botao-abrir-arquivo"
                                   title="Abrir arquivo">
                                    <img src="/imagens/abrir.png" alt="Abrir">
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <span>Ainda não há arquivos para essa tarefa...</span>
                    }

                </div>

            </section>

        </div>

    </form>

</main>

<!-- ==========================================================
     MODAL DE COMENTÁRIOS - CHAT (só leitura)
     o cliente lê a conversa, e o campo de enviar aparece bloqueado (ele não está na equipe)
     ========================================================== -->
<div id="modalComentarios" class="modal-comentarios">
    <div class="caixa-chat">

        <div class="cabecalho-chat">
            <div>
                <h2>Comentários da tarefa</h2>
                <span>Conversa entre os participantes</span>
            </div>
            <button type="button" id="fecharChat" class="fechar-chat">×</button>
        </div>

        <!-- as mensagens vêm do banco (Model.Comentarios, do mais antigo pro mais novo), montadas pelo C# -->
        <div id="mensagensChat" class="mensagens-chat">
            @if (Model.Comentarios != null && Model.Comentarios.Count() > 0) {
                @foreach (var comentario in Model.Comentarios)
                {
                    <div class="mensagem mensagem-outra">
                        <span class="nome-mensagem">(@comentario.Funcionario.Nome)</span>
                        <p>@comentario.Descricao</p>
                        <span class="horario-mensagem">@comentario.DataHora.ToString("dd/MM HH:mm")</span>
                    </div>
                }
            }
        </div>

        <!-- mesmo campo de envio das outras telas, mas sempre bloqueado: -->
        <!-- só quem está na equipe da tarefa comenta, e a equipe é formada só por funcionários -->
        <!-- não tem action: com o campo e o botão disabled, não tem como enviar (e o ComentarioController também bloqueia o cliente) -->
        <form class="formulario-chat">
            <input type="text"
                   placeholder="Só quem está na equipe da tarefa pode comentar"
                   disabled>
            <button type="button" class="enviar-comentario" disabled>Enviar</button>
        </form>

    </div>
</div>

<!-- js específico dessa tela (o mesmo da tela do gestor) -->
<script src="/js/exibicao_tarefa.js"></script>
</body>
