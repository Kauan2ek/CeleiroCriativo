<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">

    <!-- faz a página se adaptar a celulares -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- título que aparece na aba do navegador -->
    <title>Projeto - Celeiro Criativo</title>

    <!-- ícone da aba -->
    <link rel="icon" type="image/png" href="/imagens/logo.png">

    <!-- css específico dessa tela -->
    <link rel="stylesheet" href="/css/exibicao_projeto.css" />

    <!-- js que cuida do comportamento dessa tela -->
    <script src="/js/projeto.js"></script>
</head>


<body>
<!-- ==================== CABEÇALHO ==================== -->

<header class="cabecalho-projeto">

    <!-- logo que volta pra home -->
        <a href="/" class="logo-projeto">
                <img src="/imagens/logo.png"
                    alt="Logo">
        </a>



    <!-- informações do cliente logado -->
    <div class="informacoes-funcionario">

        <!-- nome do cliente (fixo por enquanto) -->
        <span>Nome do Cliente</span>

        <!-- link pro perfil do cliente -->
        <a href="/Perfil/ClientePerfil"
           class="link-perfil">

            <img src="/imagens/Entrar.png"
                 alt="Perfil do cliente">

        </a>

    </div>

</header>


<!-- ==================== CONTEÚDO ==================== -->

<main class="conteudo-exibicao">


    <!-- ==================== FORMULÁRIO ==================== -->

    <!-- form que manda os dados do projeto pro controller -->
    <form method="post"
          action="/Projeto/Salvar">


        <!-- ==================== LINHA SUPERIOR ==================== -->

        <div class="linha-superior">

            <div class="titulo-exibicao">

                <!-- botão de voltar pra lista de projetos do cliente -->
                <a href="/Projeto/ClienteProjeto"
                   class="voltar-projetos">

                    <img src="/imagens/voltar.png"
                         alt="Voltar">

                </a>

                <h1>Exibição de Projeto</h1>

            </div>


            <!-- situação do projeto -->

            <div class="situacao analise">

                <span>Situação:</span>

                <!-- select com os status possíveis do projeto -->
                <select id="situacaoProjeto"
                        name="Situacao"
                        class="status-cliente-funcionario">

                    <option value="analise" selected>
                        Em análise
                    </option>

                    <option value="andamento">
                        Em andamento
                    </option>

                    <option value="finalizado">
                        Finalizado
                    </option>

                </select>

            </div>

        </div>


        <!-- ==================== COLUNAS ==================== -->

        <div class="colunas-projeto">


            <!-- ==================== COLUNA ESQUERDA ==================== -->

            <section class="coluna-esquerda">


                <!-- título do projeto -->

                <div class="campo-projeto">

                    <label for="tituloProjeto">
                        Título do Projeto
                    </label>

                    <div class="campo-com-icone">

                        <input type="text"
                               id="tituloProjeto"
                               name="Titulo"
                               placeholder="Título do Projeto">

                    </div>

                </div>


                <!-- descrição da ideia -->

                <div class="campo-projeto">

                    <label for="descricaoProjeto">
                        Descrição de Ideia:
                    </label>

                    <div class="campo-texto">

                        <textarea id="descricaoProjeto"
                                  name="Descricao"
                                  placeholder="Texto.."></textarea>

                    </div>

                </div>


                <!-- comentários -->

                <div class="campo-projeto">

                    <label for="comentariosProjeto">
                        Comentários
                    </label>

                    <div class="campo-com-icone">

                        <input type="text"
                               id="comentariosProjeto"
                               name="Comentarios"
                               placeholder="Digite um comentário">

                    </div>

                </div>

            </section>


            <!-- ==================== COLUNA DO MEIO ==================== -->

            <section class="coluna-meio">


                <!-- data de início do projeto -->

                <div class="campo-projeto">

                    <label for="dataInicio">
                        Data de Início
                    </label>

                    <div class="campo-com-icone">

                        <input type="date"
                               id="dataInicio"
                               name="DataInicio">

                    </div>

                </div>


                <!-- previsão de término -->

                <div class="campo-projeto">

                    <label for="previsaoTermino">
                        Previsão de Término
                    </label>

                    <div class="campo-com-icone">

                        <input type="date"
                               id="previsaoTermino"
                               name="PrevisaoTermino">

                    </div>

                </div>


                <!-- data de entrega -->

                <div class="campo-projeto">

                    <label for="dataEntrega">
                        Data de Entrega
                    </label>

                    <div class="campo-com-icone">

                        <input type="date"
                               id="dataEntrega"
                               name="DataEntrega">

                    </div>

                </div>

            </section>


            <!-- ==================== COLUNA DIREITA ==================== -->

            <section class="coluna-tarefas">

                <h2>Tarefas:</h2>


                <div class="area-tarefas">


                    <!-- tarefa (só uma de exemplo por enquanto) -->

                    <div class="tarefa">

                        <!-- ícone do responsável pela tarefa -->
                        <img src="/imagens/Entrar.png"
                             alt="Responsável"
                             class="icone-responsavel">


                        <input type="text"
                               id="tituloTarefa"
                               name="Tarefa"
                               placeholder="Título Tarefa">


                        <!-- link pra abrir a tarefa na visão do cliente -->
                        <a href="/Tarefa/ClienteTarefa"
                           class="botao-expandir">

                            <img src="/imagens/abrir.png"
                                 alt="Abrir">

                        </a>

                    </div>

                </div>

            </section>

        </div>


        <!-- ==================== AÇÕES DO PROJETO ==================== -->

        <div class="acoes-projeto">


            <!-- botão salvar (por enquanto só volta pra tela anterior) -->

            <button type="button"
                    class="botao-salvar"
                    onclick="history.back()">

                Salvar

            </button>


            <!-- botões de aprovação e negação do projeto -->

            <div class="botoes-aprovacao"
                 id="botoesAprovacao">

                <button type="button"
                        class="botao-aprovar">

                    Aprovar

                </button>


                <button type="button"
                        class="botao-negar">

                    Negar

                </button>

            </div>

        </div>


    </form>

</main>
</body>
</html>