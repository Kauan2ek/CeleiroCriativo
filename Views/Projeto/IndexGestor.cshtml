@model List<Projeto>

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projetos - Gestor</title>
    <link rel="icon" type="image/png" href="/imagens/logo.png">
    <link rel="stylesheet" href="/css/projeto.css">
</head>
<body>
    <!-- ==================== CABEÇALHO ==================== -->
    <header class="cabecalho-projeto">
        <a href="/" class="logo-projeto">
            <img src="/imagens/logo.png" alt="Logo">
        </a>

        <div class="informacoes-gestor">
            <!-- A área de Funcionários agora possui listagem e cadastro reais. -->
            <a href="/Funcionario/IndexGestor" class="cadastrar-funcionario">
                Funcionários
            </a>

            <a href="/Funcionario/Criar" title="Cadastrar funcionário">
                <img src="/imagens/criar_funcionario.png" alt="Cadastrar funcionário" class="icone-perfil">
            </a>

            <!-- Login ainda não foi implementado; o nome permanece fixo nesta etapa. -->
            <span>Nome do Gestor</span>

            <a href="/Perfil/GestorPerfil" class="link-perfil">
                <img src="/imagens/Entrar.png" alt="Usuário" class="icone-usuario">
            </a>
        </div>
    </header>

    <!-- ==================== CONTEÚDO ==================== -->
    <main class="conteudo-projeto">
        <!-- Mensagens vindas dos Controllers após criar, editar ou excluir. -->
        @if (TempData["Sucesso"] != null)
        {
            <div class="mensagem-crud sucesso">@TempData["Sucesso"]</div>
        }
        @if (TempData["Erro"] != null)
        {
            <div class="mensagem-crud erro">@TempData["Erro"]</div>
        }

        <section class="lista-projetos">
            <div class="titulo-lista">
                <h1>Exibição de Projetos</h1>
                <span>Status do Projeto</span>
            </div>

            <!-- ==================== CRIAR PROJETO ==================== -->
            <!-- Projeto criado internamente pelo Gestor. O cliente será escolhido no formulário. -->
            <div class="projeto novo-projeto">
                <span class="titulo">Novo Projeto</span>

                <span class="cliente">
                    <img src="/imagens/Entrar.png" alt="Cliente">
                    <span class="cliente-nome">Selecionar cliente</span>
                </span>

                <span class="data">Data: --/--/----</span>

                <a href="@Url.Action("Criar", "Projeto")" class="botao-criar">
                    Criar
                </a>
            </div>

            <!-- ==================== PROJETOS DO BANCO ==================== -->
            @if (Model == null || Model.Count == 0)
            {
                <div class="projeto">
                    <span>Nenhum projeto cadastrado.</span>
                </div>
            }
            else
            {
                @foreach (Projeto projeto in Model)
                {
                    // A classe controla a cor da situação no CSS.
                    string statusClasse = "analise";
                    if (projeto.Status.Descricao == "Em andamento")
                    {
                        statusClasse = "andamento";
                    }
                    else if (projeto.Status.Descricao == "Finalizado")
                    {
                        statusClasse = "finalizado";
                    }

                    <div class="projeto">
                        <span class="titulo" title="@projeto.Titulo">
                            @projeto.Titulo
                        </span>

                        <span class="cliente" title="@projeto.Cliente.Nome">
                            <img src="/imagens/Entrar.png" alt="Cliente">
                            <span class="cliente-nome">@projeto.Cliente.Nome</span>
                        </span>

                        <span class="data">
                            Data: @(projeto.DataInicio.HasValue ? projeto.DataInicio.Value.ToString("dd/MM/yyyy") : "--/--/----")
                        </span>

                        <span class="status @statusClasse">
                            @projeto.Status.Descricao
                        </span>

                        <!-- Abre as informações do Projeto e suas tarefas. -->
                        <a href="@Url.Action("Detalhes", "Projeto", new { id = projeto.Codigo })"
                           class="abrir-projeto"
                           title="Abrir projeto">
                            <img src="/imagens/abrir.png" alt="Abrir projeto">
                        </a>
                    </div>
                }
            }
        </section>
    </main>
</body>
</html>
