<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">

    <!-- faz a página se adaptar a celulares -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- título que aparece na aba do navegador -->
    <title>Home - Celeiro Criativo</title>

    <!-- ícone da aba -->
    <link rel="icon" type="image/png" href="/imagens/logo.png">

    <!-- css principal do site -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- container geral da página -->
    <div class="pagina">

        <!-- ==================== CABEÇALHO ==================== -->

        <header class="cabecalho">

            <!-- logo da empresa -->
            <div class="logo">
                <img src="/imagens/logo.png" alt="Logo da empresa">
            </div>

            <!-- menu principal com links âncora pras seções -->
            <nav class="menu">

                <a href="#equipe">Equipe</a>

                <a href="#eventos">Eventos</a>

                <a href="#parcerias">Parcerias - Serviços</a>

                <!-- link do whatsapp com mensagem pronta na url -->

                <a href="https://wa.me/5517991714887?text=Olá!%20Acessei%20o%20site%20Celeiro%20Criativo%20e%20gostaria%20de%20conversar%20sobre%20estratégias%20de%20marketing%20para%20minha%20empresa.%20Podemos%20falar%20sobre%20isso?" class="icone">
                    <img src="/imagens/whats.png" alt="WhatsApp">
                </a>

                <!-- link do instagram -->
                <a href="https://www.instagram.com/celeirocriativo/" class="icone">
                    <img src="/imagens/instagram.png" alt="Instagram">

                </a>

            </nav>

            <!-- área de login no canto -->
             <div class="entrar">
                 <!-- link pra tela de entrar -->
                 <a href="/Home/Entrar">Entrar</a>
                 <img src="/imagens/Entrar.png" alt="Entrar">

            </div>

        </header>

    <!-- ==================== CHAMADA PARA PROJETO ==================== -->

        <!-- seção com o balão convidando o usuário a começar um projeto -->
        <section class="chamada-projeto">


            <div class="balao-projeto">

                <h2>Já tem uma ideia?</h2>

                <p>
                    Quer começar um projeto? Conte sua ideia para a gente
                    e vamos transformar seus planos em realidade.
                </p>

                <!-- botão que leva pro formulário de cadastro -->
                <a href="#cadastro" class="botao-projeto">
                    Começar meu projeto
                </a>

            </div>

        </section>

            <!-- ==================== BANNER ==================== -->

        <!-- banner com imagem de fundo e texto digitado via js -->
        <section class="banner">

            <div class="banner-conteudo">

                <!-- imagem de fundo do banner -->
                <img
                    src="/imagens/fundo_celeiro.png"
                    alt="Imagem da empresa"
                >

                <!-- onde o js vai digitar o texto -->
                <div class="texto-banner">
                    <h2 id="textoDigitando"></h2>
                </div>

            </div>

        </section>


        <!-- ==================== EQUIPE ==================== -->

        <section class="secao" id="equipe">

        <h2 class="titulo-secao">Equipe</h2>

        <div class="cards-equipe">

            <!-- membro 1 -->

            <div class="card-equipe">
                <img src="/imagens/membro1_design.jpg" alt="Ana Martins">

                <h3>Ana Martins</h3>
                <span>Designer</span>

                <p>
                    Responsável pela criação de layouts, identidade visual e materiais gráficos.
                </p>
            </div>

            <!-- membro 2 -->

            <div class="card-equipe">
                <img src="/imagens/membro2_video.jpg" alt="Lucas Ferreira">

                <h3>Lucas Ferreira</h3>
                <span>Video Maker</span>

                <p>
                    Responsável pela produção e edição de vídeos para apresentar nossas ideias.
                </p>
            </div>

            <!-- membro 3 -->

            <div class="card-equipe">
                <img src="/imagens/membro3_avaliacao.jpg" alt="Mariana Costa">

                <h3>Mariana Costa</h3>
                <span>Avaliação e Finanças</span>

                <p>
                    Analisa projetos, custos e resultados para garantir decisões financeiras.
                </p>
            </div>

            <!-- membro 4 -->

            <div class="card-equipe">
                <img src="/imagens/membro4_design.jpg" alt="Rafael Lima">

                <h3>Rafael Lima</h3>
                <span>Designer</span>

                <p>
                    Cuida dos elementos visuais, artes e detalhes que tornam nossos projetos únicos.
                </p>
            </div>

        </div>
        </section>

<!-- ==================== EVENTOS ==================== -->

        <!-- seção com os eventos já realizados ou previstos -->
        <section id="eventos" class="secao">

        <h2 class="titulo-secao">Eventos</h2>

        <div class="cards-eventos">

            <!-- evento 1 -->

            <div class="card-evento">
                <img src="/imagens/evento_flores.jpg" alt="Festival Primavera de Aromas">

                <div class="evento-info">
                    <span class="evento-data">12 OUT 2026</span>
                    <h3>Festival Primavera de Aromas</h3>
                    <span class="evento-empresa">Flor & Essência</span>

                    <p>
                        Evento criado para apresentar uma nova coleção
                        de perfumes e cosméticos naturais.
                    </p>
                </div>
            </div>

            <!-- evento 2 -->

            <div class="card-evento">
                <img src="/imagens/evento_tec.jpg" alt="Tech Experience 2026">

                <div class="evento-info">
                    <span class="evento-data">24 OUT 2026</span>
                    <h3>Tech Experience 2026</h3>
                    <span class="evento-empresa">ByteHouse</span>

                    <p>
                        Feira de tecnologia e games com demonstrações
                        de computadores e equipamentos.
                    </p>
                </div>
            </div>

            <!-- evento 3 -->

            <div class="card-evento">
                <img src="/imagens/evento_cafe.jpg" alt="Café & Arte">

                <div class="evento-info">
                    <span class="evento-data">07 NOV 2026</span>
                    <h3>Café & Arte</h3>
                    <span class="evento-empresa">Café Aurora</span>

                    <p>
                        Uma tarde reunindo cafés artesanais,
                        música ao vivo e artistas locais.
                    </p>
                </div>
            </div>

            <!-- evento 4 -->

            <div class="card-evento">
                <img src="/imagens/evento_eco.jpg" alt="Casa do Futuro">

                <div class="evento-info">
                    <span class="evento-data">21 NOV 2026</span>
                    <h3>Casa do Futuro</h3>
                    <span class="evento-empresa">EcoLar</span>

                    <p>
                        Exposição com soluções sustentáveis para
                        residências, tecnologia e conforto.
                    </p>
                </div>
            </div>

        </div>

        </section>



        <!-- ==================== PARCERIAS ==================== -->

        <!-- seção com as empresas parceiras -->
        <section id="parcerias" class="secao">

        <h2 class="titulo-secao">Parcerias - Serviços</h2>

        <div class="cards">

            <!-- parceria 1 -->

            <div class="card">
                <img src="/imagens/empresa_fic1.jpg" alt="Logo Flor & Essência">

                <h3>Flor & Essência</h3>

                <p>
                    Cosméticos naturais e perfumes artesanais.
                </p>
            </div>

            <!-- parceria 2 -->

            <div class="card">
                <img src="/imagens/empresa_fic2.jpg" alt="Logo ByteHouse">

                <h3>ByteHouse</h3>

                <p>
                    Tecnologia, computadores e equipamentos gamers.
                </p>
            </div>

            <!-- parceria 3 -->

            <div class="card">
                <img src="/imagens/empresa_fic3.jpg" alt="Logo Café Aurora">

                <h3>Café Aurora</h3>

                <p>
                    Cafeteria especializada em cafés artesanais e experiências culturais.
                </p>
            </div>

            <!-- parceria 4 -->

            <div class="card">
                <img src="/imagens/empresa_fic4.jpg" alt="Logo EcoLar">

                <h3>EcoLar</h3>

                <p>
                    Soluções sustentáveis e tecnologia para residências.
                </p>
            </div>

        </div>

        </section>

        <!-- ==================== CADASTRO ==================== -->

        <!-- seção do formulário de cadastro, linkada pelo âncora #cadastro -->
        <section class="cadastro" id="cadastro">

            <!-- espaço reservado pro banner do cadastro -->
            <div class="banner-cadastro">

                <img src="/imagens/banner_cad.png"
                     alt="Banner de cadastro">

            </div>


            <!-- formulário de cadastro do cliente -->
            <div class="formulario">

                <h2>Cadastre-se</h2>

                <!-- nome -->
                <label for="nome">Nome:</label>
                <input type="text"
                       id="nome"
                       placeholder="Digite seu nome">


                <!-- telefone -->
                <label for="telefone">Telefone:</label>
                <input type="tel"
                       id="telefone"
                       placeholder="(99) 99999-9999">


                <!-- email -->
                <label for="email">Email:</label>
                <input type="email"
                       id="email"
                       placeholder="exemplo@email.com">


                <!-- cpf ou cnpj -->
                <label for="documento">CPF ou CNPJ:</label>
                <input type="text"
                       id="documento"
                       placeholder="Digite seu CPF ou CNPJ">


                <!-- senha -->
                <label for="senha">Senha:</label>
                <input type="password"
                       id="senha"
                       placeholder="Digite sua senha">


                <!-- campo pra contar a ideia do projeto -->
                <label for="ideia">Ideia:</label>
                <textarea id="ideia"
                          placeholder="Conte sua ideia..."></textarea>


                <!-- botão que chama a função cadastrar() do js -->
                <button type="button" onclick="cadastrar()">
                    Cadastrar
                </button>

                <!-- link pra quem já tem conta -->
                <div class="cadastroentrar">
                     <p>Já tem cadastro?</p>
                     <a href="/Home/Entrar">Entrar</a>
                </div>

            </div>

        </section>


        <!-- ==================== RODAPÉ ==================== -->

        <footer class="rodape">

            <p>© 2026 - Celeiro Criativo</p>

        </footer>

    </div>

    <!-- js que cuida dos comportamentos da página (tipo o texto digitando) -->
    <script src="/js/script.js"></script>

</body>

</html>