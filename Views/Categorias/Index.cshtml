
@model List<Categoria>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    Teste
    <table>
        @foreach(Categoria t in Model)
        {
        <tr>
            <td>@t.Codigo</td>
            <td>@t.Descricao</td>
            <td>@t.Cor</td>
        </tr>
        }
    </table>

    <a href="/Categoria/create">Adicionar</a>
</body>
</html>