@model List<Categoria>

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categorias</title>
    <link rel="stylesheet" href="/claude/style.css">
</head>
<body class="claude-list-page">
    <div class="claude-list-card">
        <div class="claude-toolbar">
            <h1>Categorias</h1>
            <a class="claude-btn-link" href="/Categorias/Create">+ Nova Categoria</a>
        </div>

        <table class="claude-table">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Descrição</th>
                    <th>Cor</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Categoria t in Model)
                {
                    <tr>
                        <td>@t.Codigo</td>
                        <td>@t.Descricao</td>
                        <td><span class="claude-swatch" style="background-color: @t.Cor"></span>@t.Cor</td>
                        <td>
                            <div class="claude-row-actions">
                                <a class="claude-link-btn" href="/Categorias/Update/@t.Codigo">Editar</a>
                                <form class="claude-inline-form" method="post" action="/Categorias/Delete/@t.Codigo">
                                    <button type="submit" class="claude-link-danger">Excluir</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
