@model Categoria

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Categoria</title>
    <link rel="stylesheet" href="/claude/style.css">
</head>
<body class="claude-form-page">
    <div class="claude-card">
        <h1>Editar Categoria</h1>
        <p class="claude-subtitle">Atualize os dados da categoria</p>

        <form method="post" action="/Categorias/Update/@Model.Codigo">
            <div class="claude-field">
                <label for="descricao">Descrição</label>
                <input type="text" id="descricao" name="Descricao" value="@Model.Descricao">
            </div>

            <div class="claude-field">
                <label for="cor">Cor</label>
                <input type="text" id="cor" name="Cor" value="@Model.Cor">
            </div>

            <div class="claude-actions">
                <a class="claude-back-link" href="/Categorias/Index">&larr; Voltar</a>
                <button type="submit" class="claude-btn">Salvar</button>
            </div>
        </form>
    </div>
</body>
</html>
