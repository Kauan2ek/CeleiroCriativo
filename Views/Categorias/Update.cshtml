@model Categoria

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form action="/Categorias/Update/@Model.Codigo" method="POST">
        <input type="text" name="Descricao" id="Descricao" value="@Model.Descricao"> Descricao
        <input type="text" name="Cor" id="Cor" value="@Model.Cor"> Cor
        
        <button>Salvar</button>
    </form>
</body>
</html>