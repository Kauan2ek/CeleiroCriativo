@model Funcionario

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Novo Funcionário</title>
    <link rel="stylesheet" href="/claude/style.css">
</head>
<body class="claude-form-page">
    <div class="claude-card">
        <h1>Novo Funcionário</h1>
        <p class="claude-subtitle">Preencha os dados do funcionário</p>

        <form method="post" action="/Funcionarios/Create">
            <div class="claude-field">
                <label for="nome">Nome</label>
                <input type="text" id="nome" name="Nome" value="@Model?.Nome">
            </div>

            <div class="claude-field">
                <label for="telefone">Telefone</label>
                <input type="text" id="telefone" name="Telefone" value="@Model?.Telefone">
            </div>

            <div class="claude-field">
                <label for="tipoDocumento">Tipo de Documento</label>
                <input type="text" id="tipoDocumento" name="TipoDocumento" value="@Model?.TipoDocumento">
            </div>

            <div class="claude-field">
                <label for="documento">Documento</label>
                <input type="text" id="documento" name="Documento" value="@Model?.Documento">
            </div>

            <div class="claude-field">
                <label for="email">Email</label>
                <input type="email" id="email" name="Email" value="@Model?.Email">
            </div>

            <div class="claude-field">
                <label for="senha">Senha</label>
                <input type="password" id="senha" name="Senha" value="@Model?.Senha">
            </div>

            <div class="claude-actions">
                <a class="claude-back-link" href="/Funcionarios/Index">&larr; Voltar</a>
                <button type="submit" class="claude-btn">Salvar</button>
            </div>
        </form>
    </div>
</body>
</html>
